	/// Short name of the weakest scored metric in the domain.
	measure 'Driver Label' =
			VAR _K = [Worst Metric Key]
			RETURN
			    IF ( NOT ISBLANK ( _K ), CALCULATE ( SELECTEDVALUE ( 'Metric'[ShortName] ), REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _K ) )
		displayFolder: Build measures
		lineageTag: ea1e8662-4148-5828-aa4b-03c3c172526e

	/// Value of the weakest scored metric, with its unit.
	measure 'Driver Value Formatted' =
			VAR _K = [Worst Metric Key]
			RETURN
			    IF ( NOT ISBLANK ( _K ), CALCULATE ( [Metric Value Formatted], REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _K ) )
		displayFolder: Build measures
		lineageTag: 247a22ee-8742-559a-b57c-39607d6367f6

	/// Target of the weakest scored metric, with its unit.
	measure 'Driver Target Formatted' =
			VAR _K = [Worst Metric Key]
			RETURN
			    IF ( NOT ISBLANK ( _K ), CALCULATE ( [Metric Target Formatted], REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _K ) )
		displayFolder: Build measures
		lineageTag: 6235f9d7-b047-5e0f-860f-a8e08fc6aa52

	/// Team rank by composite at the quarter in context, 1 highest; ties share a rank.
	measure 'Team Rank' =
			VAR _ThisScore = [Composite]
			VAR _ReadKey = [Score Quarter Key]
			VAR _TeamDomain =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'ScoreFact', 'ScoreFact'[TeamKey], 'Domain'[DomainKey] ),
			            "@Domain", INT ( CALCULATE ( AVERAGE ( 'ScoreFact'[Score] ) ) + 0.5 )
			        ),
			        ALLSELECTED ( 'Team' ),
			        ALLSELECTED ( 'Lab' ),
			        REMOVEFILTERS ( 'Quarter' ),
			        'Quarter'[QuarterKey] = _ReadKey,
			        'ScoreFact'[IsScored] = TRUE (),
			        REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ),
			        REMOVEFILTERS ( 'Domain'[DomainKey], 'Domain'[DomainName], 'Domain'[Question], 'Domain'[SortOrder], 'Domain'[DomainGroup], 'Domain'[DomainGroupName] ),
			        'Domain'[IsCore] = TRUE ()
			    )
			VAR _Teams = GROUPBY ( _TeamDomain, 'ScoreFact'[TeamKey], "@Composite", AVERAGEX ( CURRENTGROUP (), [@Domain] ) )
			RETURN
			    IF (
			        HASONEVALUE ( 'Team'[TeamKey] ) && NOT ISBLANK ( _ThisScore ),
			        COUNTROWS ( FILTER ( _Teams, INT ( [@Composite] + 0.5 ) > _ThisScore ) ) + 1
			    )
		formatString: 0
		displayFolder: Build measures
		lineageTag: 032efa3b-1cd1-5b35-a146-8ee0b53a228b

	/// Days from the refresh date to the action's due date; blank without one action in context.
	measure 'Days From Refresh' =
			VAR _Due = SELECTEDVALUE ( 'Action'[DueDate] )
			RETURN
			    IF ( NOT ISBLANK ( _Due ), DATEDIFF ( MAX ( 'Config'[RefreshDate] ), _Due, DAY ) )
		formatString: 0
		displayFolder: Build measures
		lineageTag: a33f5126-2de6-5eaf-90e8-2c1dbb8af4b4

	/// Movement page headline (MovementPage): the composite change over the period, then the core domains that moved most and least by absolute change; ties go to the earlier domain.
	measure 'Movement Headline' =
			VAR _N = [Selected Quarters]
			VAR _ScoreNow = [Composite]
			VAR _Moved = CALCULATE ( [Score Delta over Period], REMOVEFILTERS ( 'Domain'[DomainKey], 'Domain'[DomainName], 'Domain'[Question], 'Domain'[SortOrder], 'Domain'[DomainGroup], 'Domain'[DomainGroupName] ) )
			VAR _Core = CALCULATETABLE ( 'Domain', REMOVEFILTERS ( 'Domain'[DomainKey], 'Domain'[DomainName], 'Domain'[Question], 'Domain'[SortOrder], 'Domain'[DomainGroup], 'Domain'[DomainGroupName] ), 'Domain'[IsCore] = TRUE () )
			VAR _Most = TOPN ( 1, _Core, ABS ( CALCULATE ( [Score Delta over Period] ) ), DESC, 'Domain'[SortOrder], ASC )
			VAR _Least = TOPN ( 1, _Core, ABS ( CALCULATE ( [Score Delta over Period] ) ), ASC, 'Domain'[SortOrder], ASC )
			VAR _MostDelta = MAXX ( _Most, CALCULATE ( [Score Delta over Period] ) )
			RETURN
			    "The composite moved " & FORMAT ( _Moved, "+0;−0;0" ) & " to " & _ScoreNow & " over the last " & _N & " quarters; "
			        & CONCATENATEX ( _Most, 'Domain'[DomainName] ) & IF ( _MostDelta < 0, " worsened", IF ( _MostDelta > 0, " improved", " moved" ) ) & " most (" & FORMAT ( _MostDelta, "+0;−0;0" ) & "), "
			        & CONCATENATEX ( _Least, 'Domain'[DomainName] ) & " moved least."
		displayFolder: Build measures
		lineageTag: d81759a3-87d6-5db3-8bf6-3252ec9fe5a1

	/// The composite at the first quarter of the selected period.
	measure 'Composite Period Start' =
			VAR _StartKey = [Score Quarter Key] - [Selected Quarters] + 1
			RETURN
			    IF ( _StartKey >= 1, CALCULATE ( [Composite], REMOVEFILTERS ( 'Quarter' ), 'Quarter'[QuarterKey] = _StartKey ) )
		displayFolder: Build measures
		lineageTag: b2664360-5a60-5a7a-a504-36bb3f7d0c5c

	/// [Score] at the first quarter of the selected period.
	measure 'Score Period Start' =
			VAR _StartKey = [Score Quarter Key] - [Selected Quarters] + 1
			RETURN
			    IF ( _StartKey >= 1, CALCULATE ( [Score], REMOVEFILTERS ( 'Quarter' ), 'Quarter'[QuarterKey] = _StartKey ) )
		displayFolder: Build measures
		lineageTag: 6a85c1e2-3e24-5c3e-becb-5432c0bac42c

	/// Band at the start of the period and now for one team: "Watch → Healthy", or "Healthy, held" when it did not change.
	measure 'Band Movement' =
			VAR _Healthy = MAX ( 'Config'[HealthyThreshold] )
			VAR _Watch = MAX ( 'Config'[WatchThreshold] )
			VAR _ScoreThen = [Composite Period Start]
			VAR _ScoreNow = [Composite]
			VAR _BandThen = IF ( _ScoreThen >= _Healthy, "Healthy", IF ( _ScoreThen >= _Watch, "Watch", "Act" ) )
			VAR _BandNow = IF ( _ScoreNow >= _Healthy, "Healthy", IF ( _ScoreNow >= _Watch, "Watch", "Act" ) )
			RETURN
			    IF (
			        HASONEVALUE ( 'Team'[TeamKey] ) && NOT ISBLANK ( _ScoreNow ) && NOT ISBLANK ( _ScoreThen ),
			        IF ( _BandThen = _BandNow, _BandNow & ", held", _BandThen & " → " & _BandNow )
			    )
		displayFolder: Build measures
		lineageTag: dcd68bc0-abc1-5410-9445-c692356b4c5a

	/// Metric band in lower case; unscored metrics read "context".
	measure 'Metric Band Key' =
			VAR _Band = [Metric Band]
			RETURN
			    IF ( NOT ISBLANK ( _Band ), LOWER ( _Band ) )
		displayFolder: Build measures
		lineageTag: 44b69ded-3418-5c06-a6dd-22a44873382e

	/// [Metric Value] 5 quarters before the current one: sparkline point q1.
	measure 'Metric Value Q1' =
			VAR _K = [Score Quarter Key] - 5
			RETURN
			    IF ( _K >= 1, CALCULATE ( [Metric Value], REMOVEFILTERS ( 'Quarter' ), 'Quarter'[QuarterKey] = _K ) )
		displayFolder: Build measures
		lineageTag: 9df4044b-8075-55d1-be8d-49bc64612f7a

	/// [Metric Value] 4 quarters before the current one: sparkline point q2.
	measure 'Metric Value Q2' =
			VAR _K = [Score Quarter Key] - 4
