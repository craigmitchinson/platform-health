table _Measures
	lineageTag: 6bcbff35-1299-5cbd-901f-6e372a7e7070

	/// The quarter a measure reads: the one quarter in context, else the current quarter.
	measure 'Score Quarter Key' =
			VAR _CurrentKey =
			    CALCULATE ( MAX ( 'Quarter'[QuarterKey] ), REMOVEFILTERS ( 'Quarter' ), 'Quarter'[IsCurrent] = TRUE () )
			RETURN
			    IF ( HASONEVALUE ( 'Quarter'[QuarterKey] ), VALUES ( 'Quarter'[QuarterKey] ), _CurrentKey )
		formatString: 0
		displayFolder: Quarter and value helpers
		lineageTag: 9baafc39-4065-5eaf-9db6-c4c66c1585d3

	/// Raw sum of MetricValue at the score quarter. A building block, not for visuals.
	measure 'Value At Quarter' =
			VAR _ReadKey = [Score Quarter Key]
			RETURN
			    CALCULATE ( SUM ( 'MetricValue'[Value] ), REMOVEFILTERS ( 'Quarter' ), 'Quarter'[QuarterKey] = _ReadKey )
		displayFolder: Quarter and value helpers
		lineageTag: 46733ef0-2fe7-5831-939e-420a4ea62e4d

	/// Teams in scope for the current slicers (filteredTeams).
	measure 'Teams In Scope' = COUNTROWS ( 'Team' )
		formatString: 0
		displayFolder: Quarter and value helpers
		lineageTag: 375c6efb-225c-564f-ae4e-9cd596340800

	/// Scope label: the team when one is selected, else the lab, else the estate.
	measure 'Scope Name' =
			SWITCH (
			    TRUE (),
			    ISFILTERED ( 'Team' ) && HASONEVALUE ( 'Team'[TeamKey] ), SELECTEDVALUE ( 'Team'[TeamName] ),
			    ISFILTERED ( 'Lab' ) && HASONEVALUE ( 'Lab'[LabKey] ), SELECTEDVALUE ( 'Lab'[LabName] ),
			    "the estate"
			)
		displayFolder: Quarter and value helpers
		lineageTag: cc571874-0820-5ea5-88ef-85f6e07f7103

	/// Metric value for the teams in scope, rolled up by Aggregate (aggregateMetrics). Averages are rounded to one decimal, as the app does.
	measure 'Metric Value' =
			VAR _Agg = SELECTEDVALUE ( 'Metric'[Aggregate] )
			VAR _ReadKey = [Score Quarter Key]
			VAR _Result =
			    SWITCH (
			        _Agg,
			        "sum", [Value At Quarter],
			        "avg",
			            VAR _Mean = CALCULATE ( AVERAGE ( 'MetricValue'[Value] ), REMOVEFILTERS ( 'Quarter' ), 'Quarter'[QuarterKey] = _ReadKey )
			            RETURN IF ( ISBLANK ( _Mean ), BLANK (), INT ( _Mean * 10 + 0.5 ) / 10 ),
			        "max", CALCULATE ( MAX ( 'MetricValue'[Value] ), REMOVEFILTERS ( 'Quarter' ), 'Quarter'[QuarterKey] = _ReadKey )
			    )
			RETURN
			    IF ( HASONEVALUE ( 'Metric'[MetricKey] ), _Result )
		displayFolder: Score helpers (one metric in context)
		lineageTag: 295ef487-2430-5147-88d3-1c41a113b6f2

	/// Target for the scope: sums scale with the number of teams, rates do not (targetFor).
	measure 'Metric Target' =
			VAR _Teams = MAX ( 1, [Teams In Scope] )
			VAR _Target = SELECTEDVALUE ( 'Metric'[Target] )
			RETURN
			    IF (
			        HASONEVALUE ( 'Metric'[MetricKey] ),
			        _Target * IF ( SELECTEDVALUE ( 'Metric'[Aggregate] ) = "sum", _Teams, 1 )
			    )
		displayFolder: Score helpers (one metric in context)
		lineageTag: 797d3ba5-33d2-5160-99aa-2c624a493f82

	/// Distance past target at which the metric scores 0 (spanFor), scaled like the target.
	measure 'Metric Span' =
			VAR _Teams = MAX ( 1, [Teams In Scope] )
			VAR _Target = SELECTEDVALUE ( 'Metric'[Target] )
			VAR _Dir = SELECTEDVALUE ( 'Metric'[Direction] )
			VAR _Unit = SELECTEDVALUE ( 'Metric'[Unit] )
			VAR _Span =
			    SWITCH (
			        TRUE (),
			        _Unit = "pct", IF ( _Dir = "lower", 20, 30 ),
			        _Dir = "higher", _Target,
			        MAX ( _Target * 2, 5 )
			    )
			RETURN
			    IF (
			        HASONEVALUE ( 'Metric'[MetricKey] ),
			        _Span * IF ( SELECTEDVALUE ( 'Metric'[Aggregate] ) = "sum", _Teams, 1 )
			    )
		displayFolder: Score helpers (one metric in context)
		lineageTag: 57c6fd72-ffd9-595f-bc98-37fcfb5e70d4

	/// Signed shortfall against target for the scope: above 0 means off target.
	measure 'Metric Gap' =
			VAR _Value = [Metric Value]
			VAR _Target = [Metric Target]
			RETURN
			    IF (
			        HASONEVALUE ( 'Metric'[MetricKey] ) && NOT ISBLANK ( _Value ),
			        IF ( SELECTEDVALUE ( 'Metric'[Direction] ) = "lower", _Value - _Target, _Target - _Value )
			    )
		displayFolder: Score helpers (one metric in context)
		lineageTag: 0f0ec68d-3c50-5fbc-b823-e7e7cf873a61

	/// One team's 0 to 100 score for one metric (scoreMetric with teamCount 1).
	measure 'Team Metric Score' =
			IF (
			    HASONEVALUE ( 'Team'[TeamKey] ) && HASONEVALUE ( 'Metric'[MetricKey] ),
			    VAR _ReadKey = [Score Quarter Key]
			    RETURN
			        CALCULATE ( AVERAGE ( 'ScoreFact'[Score] ), REMOVEFILTERS ( 'Quarter' ), 'Quarter'[QuarterKey] = _ReadKey, 'ScoreFact'[IsScored] = TRUE () )
			)
		formatString: 0
		displayFolder: Score helpers (one metric in context)
		lineageTag: 862e5168-09ef-5003-b07a-f232173f7673

	/// 0 to 100 metric score for the scope: the mean of each team's own score, so the band agrees with the domain score (DomainPage metricRows).
	measure 'Metric Score' =
			IF (
			    HASONEVALUE ( 'Metric'[MetricKey] ),
			    VAR _ReadKey = [Score Quarter Key]
			    VAR _Mean =
			        CALCULATE ( AVERAGE ( 'ScoreFact'[Score] ), REMOVEFILTERS ( 'Quarter' ), 'Quarter'[QuarterKey] = _ReadKey, 'ScoreFact'[IsScored] = TRUE () )
			    RETURN IF ( ISBLANK ( _Mean ), BLANK (), INT ( _Mean + 0.5 ) )
			)
		formatString: 0
		displayFolder: Score helpers (one metric in context)
		lineageTag: c27a1623-313f-5e56-b6b0-0d4b5a2f7f60

	/// Band word for the metric; context-only metrics read "Context".
	measure 'Metric Band' =
			VAR _MetricScore = [Metric Score]
			VAR _Healthy = MAX ( 'Config'[HealthyThreshold] )
			VAR _Watch = MAX ( 'Config'[WatchThreshold] )
			RETURN
			    IF (
			        HASONEVALUE ( 'Metric'[MetricKey] ),
			        IF (
			            SELECTEDVALUE ( 'Metric'[IsScored] ) = FALSE (),
			            "Context",
			            IF ( ISBLANK ( _MetricScore ), BLANK (), IF ( _MetricScore >= _Healthy, "Healthy", IF ( _MetricScore >= _Watch, "Watch", "Act" ) ) )
			        )
			    )
		displayFolder: Score helpers (one metric in context)
		lineageTag: 15dd62bd-3994-532f-a573-6dade920b9ff

	/// Change in the metric value over the selected period, one decimal (KPI tile delta).
	measure 'Metric Delta over Period' =
			VAR _CurrentKey = [Score Quarter Key]
			VAR _StartKey = _CurrentKey - [Selected Quarters] + 1
			VAR _StartValue =
			    CALCULATE ( [Metric Value], REMOVEFILTERS ( 'Quarter' ), 'Quarter'[QuarterKey] = _StartKey )
			VAR _NowValue = [Metric Value]
			RETURN
			    IF (
			        HASONEVALUE ( 'Metric'[MetricKey] ) && _StartKey >= 1 && NOT ISBLANK ( _NowValue ) && NOT ISBLANK ( _StartValue ),
			        INT ( ( _NowValue - _StartValue ) * 10 + 0.5 ) / 10
			    )
		formatString: +0.0;-0.0;0.0
		displayFolder: Score helpers (one metric in context)
		lineageTag: a66ba167-d64b-512b-a6b0-f6df258d4da2

	/// One team's score for one domain: the mean of its scored metric scores (domainScore).
	measure 'Team Domain Score' =
			IF (
			    HASONEVALUE ( 'Team'[TeamKey] ) && HASONEVALUE ( 'Domain'[DomainKey] ),
			    VAR _ReadKey = [Score Quarter Key]
			    VAR _Mean =
			        CALCULATE (
			            AVERAGE ( 'ScoreFact'[Score] ),
			            REMOVEFILTERS ( 'Quarter' ),
			            'Quarter'[QuarterKey] = _ReadKey,
			            'ScoreFact'[IsScored] = TRUE (),
			            REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] )
			        )
			    RETURN
			        IF ( NOT ISBLANK ( _Mean ), INT ( _Mean + 0.5 ) )
			)
		formatString: 0
		displayFolder: Domain and composite scores
		lineageTag: d1c8ab35-4ba6-5230-844e-0d5e6a6a0423

	/// A domain's score for the teams in scope: the mean of each team's domain score (scopeDomainScore).
	measure 'Domain Score' =
			IF (
			    HASONEVALUE ( 'Domain'[DomainKey] ),
			    VAR _ReadKey = [Score Quarter Key]
			    VAR _Teams =
			        CALCULATETABLE (
			            ADDCOLUMNS ( VALUES ( 'ScoreFact'[TeamKey] ), "@Domain", INT ( CALCULATE ( AVERAGE ( 'ScoreFact'[Score] ) ) + 0.5 ) ),
			            REMOVEFILTERS ( 'Quarter' ),
			            'Quarter'[QuarterKey] = _ReadKey,
			            'ScoreFact'[IsScored] = TRUE (),
			            REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] )
			        )
			    VAR _Mean = AVERAGEX ( _Teams, [@Domain] )
			    RETURN
			        IF ( NOT ISBLANK ( _Mean ), INT ( _Mean + 0.5 ) )
			)
		formatString: 0
		displayFolder: Domain and composite scores
		lineageTag: f976f30d-165a-5a4e-9417-b93dd57d2509

	/// One team's composite: the mean of its core domain scores (teamScore).
	measure 'Team Composite' =
			IF (
			    HASONEVALUE ( 'Team'[TeamKey] ),
			    VAR _ReadKey = [Score Quarter Key]
			    VAR _TeamDomain =
			        CALCULATETABLE (
			            ADDCOLUMNS (
			                SUMMARIZE ( 'ScoreFact', 'Domain'[DomainKey] ),
			                "@Domain", INT ( CALCULATE ( AVERAGE ( 'ScoreFact'[Score] ) ) + 0.5 )
			            ),
			            REMOVEFILTERS ( 'Quarter' ),
			            'Quarter'[QuarterKey] = _ReadKey,
			            'ScoreFact'[IsScored] = TRUE (),
			            REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ),
			            REMOVEFILTERS ( 'Domain'[DomainKey], 'Domain'[DomainName], 'Domain'[Question], 'Domain'[SortOrder], 'Domain'[DomainGroup], 'Domain'[DomainGroupName] ),
			            'Domain'[IsCore] = TRUE ()
			        )
			    VAR _Mean = AVERAGEX ( _TeamDomain, [@Domain] )
			    RETURN
			        IF ( NOT ISBLANK ( _Mean ), INT ( _Mean + 0.5 ) )
			)
		formatString: 0
		displayFolder: Domain and composite scores
		lineageTag: e479ea61-ff8e-5a11-8dd4-9fc841fc9aaf

	/// Composite for the scope: the mean of team composites (OverviewPage compositeScore, labScore).
	measure Composite =
			VAR _ReadKey = [Score Quarter Key]
			VAR _TeamDomain =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'ScoreFact', 'ScoreFact'[TeamKey], 'Domain'[DomainKey] ),
			            "@Domain", INT ( CALCULATE ( AVERAGE ( 'ScoreFact'[Score] ) ) + 0.5 )
			        ),
			        REMOVEFILTERS ( 'Quarter' ),
			        'Quarter'[QuarterKey] = _ReadKey,
			        'ScoreFact'[IsScored] = TRUE (),
			        REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ),
			        REMOVEFILTERS ( 'Domain'[DomainKey], 'Domain'[DomainName], 'Domain'[Question], 'Domain'[SortOrder], 'Domain'[DomainGroup], 'Domain'[DomainGroupName] ),
			        'Domain'[IsCore] = TRUE ()
			    )
			VAR _Teams = GROUPBY ( _TeamDomain, 'ScoreFact'[TeamKey], "@Composite", AVERAGEX ( CURRENTGROUP (), [@Domain] ) )
			VAR _Mean = AVERAGEX ( _Teams, INT ( [@Composite] + 0.5 ) )
			RETURN
			    IF ( NOT ISBLANK ( _Mean ), INT ( _Mean + 0.5 ) )
		formatString: 0
		displayFolder: Domain and composite scores
		lineageTag: 7948ae85-4665-57bb-bf5c-dad2a2d4b956

	/// The score a visual should show: the domain score with one domain in context, else the composite.
	measure Score = IF ( HASONEVALUE ( 'Domain'[DomainKey] ), [Domain Score], [Composite] )
		formatString: 0
		displayFolder: Domain and composite scores
		lineageTag: 6875c668-608f-51b9-954d-17c893c2ec52

	/// Band word for [Score], from the Config thresholds (bandFor).
	measure Band =
			VAR _ScoreNow = [Score]
			VAR _Healthy = MAX ( 'Config'[HealthyThreshold] )
			VAR _Watch = MAX ( 'Config'[WatchThreshold] )
			RETURN
			    IF ( NOT ISBLANK ( _ScoreNow ), IF ( _ScoreNow >= _Healthy, "Healthy", IF ( _ScoreNow >= _Watch, "Watch", "Act" ) ) )
		displayFolder: Domain and composite scores
		lineageTag: 198997e8-ddea-54a3-b7ec-93bed63b5207

	/// Quarters in the trend window from the disconnected Period slicer; six when none is chosen.
	measure 'Selected Quarters' = SELECTEDVALUE ( 'Period'[Quarters], 6 )
		formatString: 0
		displayFolder: Period
		lineageTag: 89a54dbc-a658-5575-81a7-a64374ed24aa

	/// 1 when the quarter in context sits inside the selected window, else blank. Use as a visual filter (is 1) on trend visuals with Quarter[QuarterLabel] on the axis.
	measure 'In Selected Period' =
			VAR _CurrentKey =
			    CALCULATE ( MAX ( 'Quarter'[QuarterKey] ), REMOVEFILTERS ( 'Quarter' ), 'Quarter'[IsCurrent] = TRUE () )
			VAR _ThisKey = SELECTEDVALUE ( 'Quarter'[QuarterKey] )
			RETURN
			    IF ( _ThisKey > _CurrentKey - [Selected Quarters] && _ThisKey <= _CurrentKey, 1 )
		formatString: 0
		displayFolder: Period
		lineageTag: 24740c68-dfb5-525a-9696-e3ba9d08e4cc

	/// Change in [Score] against the previous quarter.
	measure 'Score Delta vs Previous' =
			VAR _CurrentKey = [Score Quarter Key]
			VAR _Previous =
			    CALCULATE ( [Score], REMOVEFILTERS ( 'Quarter' ), 'Quarter'[QuarterKey] = _CurrentKey - 1 )
			VAR _ScoreNow = [Score]
			RETURN
			    IF ( _CurrentKey > 1 && NOT ISBLANK ( _ScoreNow ) && NOT ISBLANK ( _Previous ), _ScoreNow - _Previous )
		formatString: +0;-0;0
		displayFolder: Period
		lineageTag: ae6703d2-cf24-5aa6-80f9-b3839a64df40

	/// Change in [Score] from the first to the last quarter of the selected period (the Labs movers and the domain trend read-out).
	measure 'Score Delta over Period' =
			VAR _CurrentKey = [Score Quarter Key]
			VAR _StartKey = _CurrentKey - [Selected Quarters] + 1
			VAR _Start =
			    CALCULATE ( [Score], REMOVEFILTERS ( 'Quarter' ), 'Quarter'[QuarterKey] = _StartKey )
			VAR _ScoreNow = [Score]
			RETURN
			    IF ( _StartKey >= 1 && NOT ISBLANK ( _ScoreNow ) && NOT ISBLANK ( _Start ), _ScoreNow - _Start )
		formatString: +0;-0;0
		displayFolder: Period
		lineageTag: 367c5c9b-520e-5c65-a688-dfc0732eb727

	/// Core domains scoring Healthy for the scope.
	measure 'Domains Healthy' =
			VAR _Healthy = MAX ( 'Config'[HealthyThreshold] )
			VAR _ReadKey = [Score Quarter Key]
			VAR _TeamDomain =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'ScoreFact', 'ScoreFact'[TeamKey], 'Domain'[DomainKey] ),
			            "@Domain", INT ( CALCULATE ( AVERAGE ( 'ScoreFact'[Score] ) ) + 0.5 )
			        ),
			        REMOVEFILTERS ( 'Quarter' ),
			        'Quarter'[QuarterKey] = _ReadKey,
			        'ScoreFact'[IsScored] = TRUE (),
			        REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ),
			        REMOVEFILTERS ( 'Domain'[DomainKey], 'Domain'[DomainName], 'Domain'[Question], 'Domain'[SortOrder], 'Domain'[DomainGroup], 'Domain'[DomainGroupName] ),
			        'Domain'[IsCore] = TRUE ()
			    )
			VAR _Domains = GROUPBY ( _TeamDomain, 'Domain'[DomainKey], "@Mean", AVERAGEX ( CURRENTGROUP (), [@Domain] ) )
			RETURN
			    COUNTROWS ( FILTER ( _Domains, INT ( [@Mean] + 0.5 ) >= _Healthy ) )
		formatString: 0
		displayFolder: Counts
		lineageTag: 78d4c78c-d359-5a48-8616-586a2d01d433

	/// Core domains scoring Watch for the scope.
	measure 'Domains Watch' =
			VAR _Healthy = MAX ( 'Config'[HealthyThreshold] )
			VAR _Watch = MAX ( 'Config'[WatchThreshold] )
			VAR _ReadKey = [Score Quarter Key]
			VAR _TeamDomain =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'ScoreFact', 'ScoreFact'[TeamKey], 'Domain'[DomainKey] ),
			            "@Domain", INT ( CALCULATE ( AVERAGE ( 'ScoreFact'[Score] ) ) + 0.5 )
			        ),
			        REMOVEFILTERS ( 'Quarter' ),
			        'Quarter'[QuarterKey] = _ReadKey,
			        'ScoreFact'[IsScored] = TRUE (),
			        REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ),
			        REMOVEFILTERS ( 'Domain'[DomainKey], 'Domain'[DomainName], 'Domain'[Question], 'Domain'[SortOrder], 'Domain'[DomainGroup], 'Domain'[DomainGroupName] ),
			        'Domain'[IsCore] = TRUE ()
			    )
			VAR _Domains = GROUPBY ( _TeamDomain, 'Domain'[DomainKey], "@Mean", AVERAGEX ( CURRENTGROUP (), [@Domain] ) )
			RETURN
			    COUNTROWS ( FILTER ( _Domains, INT ( [@Mean] + 0.5 ) >= _Watch && INT ( [@Mean] + 0.5 ) < _Healthy ) )
		formatString: 0
		displayFolder: Counts
		lineageTag: deeab74b-ce7c-50be-8b9a-486c5ba56a76

	/// Core domains scoring Act for the scope.
	measure 'Domains Act' =
			VAR _Watch = MAX ( 'Config'[WatchThreshold] )
			VAR _ReadKey = [Score Quarter Key]
			VAR _TeamDomain =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'ScoreFact', 'ScoreFact'[TeamKey], 'Domain'[DomainKey] ),
			            "@Domain", INT ( CALCULATE ( AVERAGE ( 'ScoreFact'[Score] ) ) + 0.5 )
			        ),
			        REMOVEFILTERS ( 'Quarter' ),
			        'Quarter'[QuarterKey] = _ReadKey,
			        'ScoreFact'[IsScored] = TRUE (),
			        REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ),
			        REMOVEFILTERS ( 'Domain'[DomainKey], 'Domain'[DomainName], 'Domain'[Question], 'Domain'[SortOrder], 'Domain'[DomainGroup], 'Domain'[DomainGroupName] ),
			        'Domain'[IsCore] = TRUE ()
			    )
			VAR _Domains = GROUPBY ( _TeamDomain, 'Domain'[DomainKey], "@Mean", AVERAGEX ( CURRENTGROUP (), [@Domain] ) )
			RETURN
			    COUNTROWS ( FILTER ( _Domains, INT ( [@Mean] + 0.5 ) < _Watch ) )
		formatString: 0
		displayFolder: Counts
		lineageTag: 2053f9e5-e4b6-5c73-9894-2a18b70662df

	/// Number of core domains.
	measure 'Core Domains' = CALCULATE ( COUNTROWS ( 'Domain' ), REMOVEFILTERS ( 'Domain'[DomainKey], 'Domain'[DomainName], 'Domain'[Question], 'Domain'[SortOrder], 'Domain'[DomainGroup], 'Domain'[DomainGroupName] ), 'Domain'[IsCore] = TRUE () )
		formatString: 0
		displayFolder: Counts
		lineageTag: 6415c0a8-63b4-5551-8bd7-7a0e44a79043

	/// Teams in scope whose composite is Healthy (Labs page lab cards).
	measure 'Teams Healthy' =
			VAR _Healthy = MAX ( 'Config'[HealthyThreshold] )
			VAR _ReadKey = [Score Quarter Key]
			VAR _TeamDomain =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'ScoreFact', 'ScoreFact'[TeamKey], 'Domain'[DomainKey] ),
			            "@Domain", INT ( CALCULATE ( AVERAGE ( 'ScoreFact'[Score] ) ) + 0.5 )
			        ),
			        REMOVEFILTERS ( 'Quarter' ),
			        'Quarter'[QuarterKey] = _ReadKey,
			        'ScoreFact'[IsScored] = TRUE (),
			        REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ),
			        REMOVEFILTERS ( 'Domain'[DomainKey], 'Domain'[DomainName], 'Domain'[Question], 'Domain'[SortOrder], 'Domain'[DomainGroup], 'Domain'[DomainGroupName] ),
			        'Domain'[IsCore] = TRUE ()
			    )
			VAR _Teams = GROUPBY ( _TeamDomain, 'ScoreFact'[TeamKey], "@Composite", AVERAGEX ( CURRENTGROUP (), [@Domain] ) )
			RETURN
			    COUNTROWS ( FILTER ( _Teams, INT ( [@Composite] + 0.5 ) >= _Healthy ) )
		formatString: 0
		displayFolder: Counts
		lineageTag: 5ed45dfc-b32d-5678-9a15-708a49697fad

	/// Teams in scope whose composite is Watch (Labs page lab cards).
	measure 'Teams Watch' =
			VAR _Healthy = MAX ( 'Config'[HealthyThreshold] )
			VAR _Watch = MAX ( 'Config'[WatchThreshold] )
			VAR _ReadKey = [Score Quarter Key]
			VAR _TeamDomain =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'ScoreFact', 'ScoreFact'[TeamKey], 'Domain'[DomainKey] ),
			            "@Domain", INT ( CALCULATE ( AVERAGE ( 'ScoreFact'[Score] ) ) + 0.5 )
			        ),
			        REMOVEFILTERS ( 'Quarter' ),
			        'Quarter'[QuarterKey] = _ReadKey,
			        'ScoreFact'[IsScored] = TRUE (),
			        REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ),
			        REMOVEFILTERS ( 'Domain'[DomainKey], 'Domain'[DomainName], 'Domain'[Question], 'Domain'[SortOrder], 'Domain'[DomainGroup], 'Domain'[DomainGroupName] ),
			        'Domain'[IsCore] = TRUE ()
			    )
			VAR _Teams = GROUPBY ( _TeamDomain, 'ScoreFact'[TeamKey], "@Composite", AVERAGEX ( CURRENTGROUP (), [@Domain] ) )
			RETURN
			    COUNTROWS ( FILTER ( _Teams, INT ( [@Composite] + 0.5 ) >= _Watch && INT ( [@Composite] + 0.5 ) < _Healthy ) )
		formatString: 0
		displayFolder: Counts
		lineageTag: 1b929194-aa12-5e36-b21f-90b19c3283b9

	/// Teams in scope whose composite is in the Act band.
	measure 'Teams Needing Action' =
			VAR _Watch = MAX ( 'Config'[WatchThreshold] )
			VAR _ReadKey = [Score Quarter Key]
			VAR _TeamDomain =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'ScoreFact', 'ScoreFact'[TeamKey], 'Domain'[DomainKey] ),
			            "@Domain", INT ( CALCULATE ( AVERAGE ( 'ScoreFact'[Score] ) ) + 0.5 )
			        ),
			        REMOVEFILTERS ( 'Quarter' ),
			        'Quarter'[QuarterKey] = _ReadKey,
			        'ScoreFact'[IsScored] = TRUE (),
			        REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ),
			        REMOVEFILTERS ( 'Domain'[DomainKey], 'Domain'[DomainName], 'Domain'[Question], 'Domain'[SortOrder], 'Domain'[DomainGroup], 'Domain'[DomainGroupName] ),
			        'Domain'[IsCore] = TRUE ()
			    )
			VAR _Teams = GROUPBY ( _TeamDomain, 'ScoreFact'[TeamKey], "@Composite", AVERAGEX ( CURRENTGROUP (), [@Domain] ) )
			RETURN
			    COUNTROWS ( FILTER ( _Teams, INT ( [@Composite] + 0.5 ) < _Watch ) )
		formatString: 0
		displayFolder: Counts
		lineageTag: cf45d824-0817-5ce8-8b2e-989aa8cb99fb

	/// Name of the lowest-scoring core domain for the scope; ties go to the earlier domain.
	measure 'Worst Domain' =
			VAR _ReadKey = [Score Quarter Key]
			VAR _TeamDomain =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'ScoreFact', 'ScoreFact'[TeamKey], 'Domain'[DomainKey], 'Domain'[SortOrder], 'Domain'[DomainName] ),
			            "@Domain", INT ( CALCULATE ( AVERAGE ( 'ScoreFact'[Score] ) ) + 0.5 )
			        ),
			        REMOVEFILTERS ( 'Quarter' ),
			        'Quarter'[QuarterKey] = _ReadKey,
			        'ScoreFact'[IsScored] = TRUE (),
			        REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ),
			        REMOVEFILTERS ( 'Domain'[DomainKey], 'Domain'[DomainName], 'Domain'[Question], 'Domain'[SortOrder], 'Domain'[DomainGroup], 'Domain'[DomainGroupName] ),
			        'Domain'[IsCore] = TRUE ()
			    )
			VAR _Domains =
			    GROUPBY (
			        _TeamDomain,
			        'Domain'[DomainKey], 'Domain'[SortOrder], 'Domain'[DomainName],
			        "@Mean", AVERAGEX ( CURRENTGROUP (), [@Domain] )
			    )
			VAR _Worst = TOPN ( 1, _Domains, INT ( [@Mean] + 0.5 ), ASC, 'Domain'[SortOrder], ASC )
			RETURN
			    CONCATENATEX ( _Worst, 'Domain'[DomainName] )
		displayFolder: Counts
		lineageTag: 9d4a5c36-4641-5cea-8569-090d3f3d90a9

	/// Open actions in scope.
	measure 'Open Actions' = COUNTROWS ( 'Action' )
		formatString: 0
		displayFolder: Counts
		lineageTag: 52966527-cb48-5b2a-8f42-2c35d334db78

	/// Open actions in scope due before the refresh date.
	measure 'Actions Past Due' =
			VAR _Refreshed = MAX ( 'Config'[RefreshDate] )
			RETURN
			    COUNTROWS ( FILTER ( 'Action', 'Action'[DueDate] < _Refreshed ) )
		formatString: 0
		displayFolder: Counts
		lineageTag: 1edfaa29-f904-52cd-9ea1-3f09640e0056

	/// Open actions in scope due from the refresh date to 30 days after it, inclusive.
	measure 'Actions Due 30 Days' =
			VAR _Refreshed = MAX ( 'Config'[RefreshDate] )
			RETURN
			    COUNTROWS ( FILTER ( 'Action', 'Action'[DueDate] >= _Refreshed && 'Action'[DueDate] <= _Refreshed + 30 ) )
		formatString: 0
		displayFolder: Counts
		lineageTag: d08eef01-bc47-5613-81df-c9357fe3b1ad

	/// Open actions in scope of Act severity.
	measure 'Actions Act' = COUNTROWS ( FILTER ( 'Action', 'Action'[Severity] = "act" ) )
		displayFolder: Counts
		lineageTag: c80659c3-2d46-5447-b5f0-bebf965da878

	/// Open actions in scope due from the refresh date to 7 days after it, inclusive.
	measure 'Actions This Week' =
			VAR _Refreshed = MAX ( 'Config'[RefreshDate] )
			RETURN
			    COUNTROWS ( FILTER ( 'Action', 'Action'[DueDate] >= _Refreshed && 'Action'[DueDate] <= _Refreshed + 7 ) )
		displayFolder: Counts
		lineageTag: 35ea692c-5610-5773-b1a7-db7e1b7753c0

	/// Open actions in scope due 8 to 30 days after the refresh date.
	measure 'Actions Next 30 Days' =
			VAR _Refreshed = MAX ( 'Config'[RefreshDate] )
			RETURN
			    COUNTROWS ( FILTER ( 'Action', 'Action'[DueDate] > _Refreshed + 7 && 'Action'[DueDate] <= _Refreshed + 30 ) )
		displayFolder: Counts
		lineageTag: 85691e1a-a23f-5643-b339-a433a08b8c40

	/// Open actions in scope due more than 30 days after the refresh date.
	measure 'Actions Later' =
			VAR _Refreshed = MAX ( 'Config'[RefreshDate] )
			RETURN
			    COUNTROWS ( FILTER ( 'Action', 'Action'[DueDate] > _Refreshed + 30 ) )
		displayFolder: Counts
		lineageTag: 49ce043c-998f-57d4-a0c6-75386b51eac7

	/// Metric value with its unit: count, pct, days, gbp, perMonth, level ("x.x of 5").
	measure 'Metric Value Formatted' =
			VAR _X = [Metric Value]
			VAR _Unit = SELECTEDVALUE ( 'Metric'[Unit] )
			VAR _X3 = ROUND ( _X, 3 )
			VAR _Num = IF ( _X3 = INT ( _X3 ), FORMAT ( _X3, "#,0" ), FORMAT ( _X3, "#,0.###" ) )
			VAR _X1 = ROUND ( _X, 1 )
			VAR _Pct = IF ( _X1 = INT ( _X1 ), FORMAT ( _X1, "#,0" ), FORMAT ( _X1, "#,0.0" ) )
			RETURN
			    IF (
			        HASONEVALUE ( 'Metric'[MetricKey] ) && NOT ISBLANK ( _X ),
			        SWITCH (
			            _Unit,
			            "pct", _Pct & "%",
			            "days", _Num & " days",
			            "gbp", "£" & _Num,
			            "perMonth", _Num & " / month",
			            "level", FORMAT ( _X, "0.0" ) & " of 5",
			            _Num
			        )
			    )
		displayFolder: Formatting (formatValue in src/components/primitives.tsx)
		lineageTag: b6680746-56ef-5f90-a1e2-28e751ae3516

	/// Target for the scope with its unit, formatted as the value is.
	measure 'Metric Target Formatted' =
			VAR _X = [Metric Target]
			VAR _Unit = SELECTEDVALUE ( 'Metric'[Unit] )
			VAR _X3 = ROUND ( _X, 3 )
			VAR _Num = IF ( _X3 = INT ( _X3 ), FORMAT ( _X3, "#,0" ), FORMAT ( _X3, "#,0.###" ) )
			VAR _X1 = ROUND ( _X, 1 )
			VAR _Pct = IF ( _X1 = INT ( _X1 ), FORMAT ( _X1, "#,0" ), FORMAT ( _X1, "#,0.0" ) )
			RETURN
			    IF (
			        HASONEVALUE ( 'Metric'[MetricKey] ) && NOT ISBLANK ( _X ),
			        SWITCH (
			            _Unit,
			            "pct", _Pct & "%",
			            "days", _Num & " days",
			            "gbp", "£" & _Num,
			            "perMonth", _Num & " / month",
			            "level", FORMAT ( _X, "0.0" ) & " of 5",
			            _Num
			        )
			    )
		displayFolder: Formatting (formatValue in src/components/primitives.tsx)
		lineageTag: 24dd2653-a3c8-5792-be70-fb74877a47a4

	/// Key of the scored metric with the lowest [Metric Score]; ties go to the earlier metric.
	measure 'Worst Metric Key' =
			VAR _ReadKey = [Score Quarter Key]
			VAR _Rows =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'ScoreFact', 'Metric'[MetricKey], 'Metric'[SortOrder] ),
			            "@Score", INT ( CALCULATE ( AVERAGE ( 'ScoreFact'[Score] ) ) + 0.5 )
			        ),
			        REMOVEFILTERS ( 'Quarter' ),
			        'Quarter'[QuarterKey] = _ReadKey,
			        'ScoreFact'[IsScored] = TRUE (),
			        REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] )
			    )
			RETURN
			    IF (
			        HASONEVALUE ( 'Domain'[DomainKey] ) && COUNTROWS ( _Rows ) > 0,
			        CONCATENATEX ( TOPN ( 1, _Rows, [@Score], ASC, 'Metric'[SortOrder], ASC ), 'Metric'[MetricKey] )
			    )
		displayFolder: Worst and best metric of a domain (one domain in context)
		lineageTag: 9388be4a-03a7-5724-bc7e-96b896be939e

	/// Key of the scored metric with the highest [Metric Score]; ties go to the earlier metric.
	measure 'Best Metric Key' =
			VAR _ReadKey = [Score Quarter Key]
			VAR _Rows =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'ScoreFact', 'Metric'[MetricKey], 'Metric'[SortOrder] ),
			            "@Score", INT ( CALCULATE ( AVERAGE ( 'ScoreFact'[Score] ) ) + 0.5 )
			        ),
			        REMOVEFILTERS ( 'Quarter' ),
			        'Quarter'[QuarterKey] = _ReadKey,
			        'ScoreFact'[IsScored] = TRUE (),
			        REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] )
			    )
			RETURN
			    IF (
			        HASONEVALUE ( 'Domain'[DomainKey] ) && COUNTROWS ( _Rows ) > 0,
			        CONCATENATEX ( TOPN ( 1, _Rows, [@Score], DESC, 'Metric'[SortOrder], ASC ), 'Metric'[MetricKey] )
			    )
		displayFolder: Worst and best metric of a domain (one domain in context)
		lineageTag: e49c0529-f58d-583a-8097-349318eb0604

	/// Overview domain card driver line: "{short}: {value} vs target {target}".
	measure 'Domain Driver' =
			VAR _DriverKey = [Worst Metric Key]
			RETURN
			    IF (
			        NOT ISBLANK ( _DriverKey ),
			        CALCULATE (
			            SELECTEDVALUE ( 'Metric'[ShortName] ) & ": " & [Metric Value Formatted] & " vs target "
			                & [Metric Target Formatted],
			            REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ),
			            'Metric'[MetricKey] = _DriverKey
			        )
			    )
		displayFolder: Worst and best metric of a domain (one domain in context)
		lineageTag: b889f1cf-8943-5693-87e6-3b7882e94164

	/// Overview headline (OverviewPage).
	measure 'Overview Headline' =
			VAR _Healthy = COALESCE ( [Domains Healthy], 0 )
			VAR _Teams = COALESCE ( [Teams Needing Action], 0 )
			VAR _Worst = [Worst Domain]
			VAR _TeamsLine =
			    IF (
			        _Teams = 0,
			        "No team needs action; " & _Worst & " is the weakest domain.",
			        _Teams & IF ( _Teams = 1, " team needs", " teams need" ) & " action, led by " & _Worst & "."
			    )
			RETURN
			    _Healthy & " of " & [Core Domains] & " domains healthy across " & [Scope Name] & ". " & _TeamsLine
		displayFolder: Headlines and read-outs
		lineageTag: 2f6b1a53-1b86-54ac-8962-65de8870dc8d

	/// Labs headline (labHeadline in LabsPage): single team, single lab, estate with and without Act ratings, and no teams in scope.
	measure 'Labs Headline' =
			VAR _Watch = MAX ( 'Config'[WatchThreshold] )
			VAR _Healthy = MAX ( 'Config'[HealthyThreshold] )
			VAR _IsTeam = ISFILTERED ( 'Team' ) && HASONEVALUE ( 'Team'[TeamKey] )
			VAR _TeamScore = [Composite]
			VAR _TeamBand = IF ( _TeamScore >= _Healthy, "Healthy", IF ( _TeamScore >= _Watch, "Watch", "Act" ) )
			VAR _Labs =
			    FILTER (
			        ADDCOLUMNS (
			            'Lab',
			            "@Teams", CALCULATE ( COUNTROWS ( 'Team' ) ) + 0,
			            "@Score", CALCULATE ( [Composite] ),
			            "@Act", CALCULATE ( COALESCE ( [Teams Needing Action], 0 ) )
			        ),
			        [@Teams] > 0
			    )
			VAR _LabCount = COUNTROWS ( _Labs ) + 0
			VAR _Best = TOPN ( 1, _Labs, [@Score], DESC, 'Lab'[SortOrder], ASC )
			VAR _MostAct = TOPN ( 1, _Labs, [@Act], DESC, 'Lab'[SortOrder], ASC )
			VAR _MostActCount = MAXX ( _MostAct, [@Act] )
			RETURN
			    SWITCH (
			        TRUE (),
			        _IsTeam,
			            SELECTEDVALUE ( 'Team'[TeamName] ) & " scores " & _TeamScore & ", in the " & _TeamBand & " band.",
			        _LabCount = 0, "No teams in scope.",
			        _LabCount = 1,
			            CONCATENATEX ( _Labs, 'Lab'[LabName] ) & " scores " & MAXX ( _Labs, [@Score] ) & "; "
			                & MAXX ( _Labs, [@Act] ) & " of " & MAXX ( _Labs, [@Teams] ) & " teams sit in the Act band.",
			        _MostActCount > 0,
			            CONCATENATEX ( _Best, 'Lab'[LabName] ) & " is the healthiest lab; "
			                & CONCATENATEX ( _MostAct, 'Lab'[LabName] ) & " carries the most Act ratings.",
			        CONCATENATEX ( _Best, 'Lab'[LabName] ) & " is the healthiest lab; no lab has a team in the Act band."
			    )
		displayFolder: Headlines and read-outs
		lineageTag: fe384959-6813-5dc8-86ce-9b9c22181bf7

	/// Domain page headline (DomainPage): furthest-from-target, inside-in-total, every-metric (only when the worst metric scores 100) and no-scored-metric branches.
	measure 'Domain Headline' =
			VAR _DomainName = SELECTEDVALUE ( 'Domain'[DomainName] )
			VAR _Healthy = MAX ( 'Config'[HealthyThreshold] )
			VAR _Watch = MAX ( 'Config'[WatchThreshold] )
			VAR _ScoreNow = [Domain Score]
			VAR _BandWord = IF ( _ScoreNow >= _Healthy, "healthy", IF ( _ScoreNow >= _Watch, "watch", "act" ) )
			VAR _WorstKey = [Worst Metric Key]
			VAR _BestKey = [Best Metric Key]
			VAR _WorstName = CALCULATE ( SELECTEDVALUE ( 'Metric'[MetricName] ), REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _WorstKey )
			VAR _WorstScore = CALCULATE ( [Metric Score], REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _WorstKey )
			VAR _WorstGap = CALCULATE ( [Metric Gap], REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _WorstKey )
			VAR _WorstValue = CALCULATE ( [Metric Value Formatted], REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _WorstKey )
			VAR _WorstTarget = CALCULATE ( [Metric Target Formatted], REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _WorstKey )
			VAR _BestName = CALCULATE ( SELECTEDVALUE ( 'Metric'[MetricName] ), REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _BestKey )
			VAR _BestGap = CALCULATE ( [Metric Gap], REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _BestKey )
			VAR _BestValue = CALCULATE ( [Metric Value Formatted], REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _BestKey )
			VAR _BestTarget = CALCULATE ( [Metric Target Formatted], REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _BestKey )
			VAR _BestWording =
			    IF (
			        _BestGap < 0,
			        _BestName & " is ahead of target",
			        IF (
			            _BestGap = 0,
			            _BestName & " is on target",
			            _BestName & " is closest to target at " & _BestValue & " against " & _BestTarget
			        )
			    )
			VAR _BestClause = IF ( _BestKey = _WorstKey, "", "; " & _BestWording )
			VAR _ScoreLead = _DomainName & " scores " & _ScoreNow & ", " & _BandWord & "."
			RETURN
			    IF (
			        HASONEVALUE ( 'Domain'[DomainKey] ),
			        SWITCH (
			            TRUE (),
			            ISBLANK ( _WorstKey ) || ISBLANK ( _BestKey ), "No measure in " & _DomainName & " is scored yet.",
			            _WorstScore = 100, _ScoreLead & " Every metric is on or ahead of target.",
			            _WorstGap > 0,
			                _ScoreLead & " " & _WorstName & " is furthest from target at " & _WorstValue & " against "
			                    & _WorstTarget & _BestClause & ".",
			            _ScoreLead & " " & _WorstName & " is inside target in total, but not for every team" & _BestClause & "."
			        )
			    )
		displayFolder: Headlines and read-outs
		lineageTag: 1e935ef1-c25a-5d31-b4bc-060bcccc346a

	/// Sources headline (SourcesPage). Estate-wide: ignores every slicer.
	measure 'Sources Headline' =
			VAR _Metrics = ALL ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName], 'Metric'[Readiness] )
			VAR _Total = COUNTROWS ( _Metrics )
			VAR _Live = COUNTROWS ( FILTER ( _Metrics, 'Metric'[Readiness] = "live" ) ) + 0
			VAR _Partial = COUNTROWS ( FILTER ( _Metrics, 'Metric'[Readiness] = "partial" ) ) + 0
			VAR _Aspirational = COUNTROWS ( FILTER ( _Metrics, 'Metric'[Readiness] = "aspirational" ) ) + 0
			RETURN
			    _Live & " of " & _Total & " metrics are live today; " & _Partial & " are partial and " & _Aspirational
			        & " are aspirational. Plan for all of them."
		displayFolder: Headlines and read-outs
		lineageTag: fe4e72b4-32d2-514f-af20-7143a0bfbe41

	/// Actions headline (ActionsPage).
	measure 'Actions Headline' =
			VAR _Open = COALESCE ( [Open Actions], 0 )
			RETURN
			    _Open & " open action" & IF ( _Open = 1, "", "s" ) & " across " & [Scope Name] & "; " & COALESCE ( [Actions Past Due], 0 )
			        & " past due, " & COALESCE ( [Actions Due 30 Days], 0 ) & " due within 30 days."
		displayFolder: Headlines and read-outs
		lineageTag: 87628dca-63af-5f38-8f5c-55c9caad40bc

	/// Domain read-out 1: the worst metric's gap to target, or confirmation it is inside target.
	measure 'Read Out 1' =
			VAR _WorstKey = [Worst Metric Key]
			VAR _ScopeName = [Scope Name]
			VAR _WorstName = CALCULATE ( SELECTEDVALUE ( 'Metric'[MetricName] ), REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _WorstKey )
			VAR _WorstUnit = CALCULATE ( SELECTEDVALUE ( 'Metric'[Unit] ), REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _WorstKey )
			VAR _WorstScore = CALCULATE ( [Metric Score], REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _WorstKey )
			VAR _WorstGap = CALCULATE ( [Metric Gap], REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _WorstKey )
			VAR _G = INT ( _WorstGap * 10 + 0.5 ) / 10
			VAR _G3 = ROUND ( _G, 3 )
			VAR _Num = IF ( _G3 = INT ( _G3 ), FORMAT ( _G3, "#,0" ), FORMAT ( _G3, "#,0.###" ) )
			VAR _G1 = ROUND ( _G, 1 )
			VAR _Pct = IF ( _G1 = INT ( _G1 ), FORMAT ( _G1, "#,0" ), FORMAT ( _G1, "#,0.0" ) )
			VAR _GapText =
			    SWITCH (
			        _WorstUnit,
			        "pct", _Pct & "%",
			        "days", _Num & " days",
			        "gbp", "£" & _Num,
			        "perMonth", _Num & " / month",
			        "level", FORMAT ( _G, "0.0" ) & " of 5",
			        _Num
			    )
			RETURN
			    IF (
			        HASONEVALUE ( 'Domain'[DomainKey] ),
			        SWITCH (
			            TRUE (),
			            ISBLANK ( _WorstKey ), "No measure in this domain is scored yet.",
			            _WorstGap > 0, _WorstName & " is " & _GapText & " off target across " & _ScopeName & ".",
			            _WorstScore < 100,
			                _WorstName & " is inside target across " & _ScopeName & " in total, but not for every team.",
			            "Every scored measure is at or inside target across " & _ScopeName & "."
			        )
			    )
		displayFolder: Headlines and read-outs
		lineageTag: 076e5848-984a-54c3-96d1-d0933da6a23f

	/// Domain read-out 2: concentration of a summed metric, range of an averaged one, or a single team against the estate average.
	measure 'Read Out 2' =
			VAR _WorstKey = [Worst Metric Key]
			VAR _ScopeName = [Scope Name]
			VAR _TeamCount = [Teams In Scope]
			VAR _WorstName = CALCULATE ( SELECTEDVALUE ( 'Metric'[MetricName] ), REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _WorstKey )
			VAR _WorstUnit = CALCULATE ( SELECTEDVALUE ( 'Metric'[Unit] ), REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _WorstKey )
			VAR _WorstAgg = CALCULATE ( SELECTEDVALUE ( 'Metric'[Aggregate] ), REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ), 'Metric'[MetricKey] = _WorstKey )
			VAR _ReadKey = [Score Quarter Key]
			VAR _Shares =
			    CALCULATETABLE (
			        ADDCOLUMNS ( SUMMARIZE ( 'ScoreFact', 'Team'[TeamKey], 'Team'[TeamName], 'Team'[SortOrder] ), "@Value", CALCULATE ( SUM ( 'ScoreFact'[Value] ) ) ),
			        REMOVEFILTERS ( 'Quarter' ),
			        'Quarter'[QuarterKey] = _ReadKey,
			        REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ),
			        'Metric'[MetricKey] = _WorstKey
			    )
			VAR _Total = SUMX ( _Shares, [@Value] )
			VAR _Top2 = TOPN ( 2, _Shares, [@Value], DESC, 'Team'[SortOrder], ASC )
			VAR _Top2Names = CONCATENATEX ( _Top2, 'Team'[TeamName], " and ", [@Value], DESC, 'Team'[SortOrder], ASC )
			VAR _Share = IF ( _Total > 0, INT ( SUMX ( _Top2, [@Value] ) / _Total * 100 + 0.5 ), 0 )
			VAR _Lo = MINX ( _Shares, [@Value] )
			VAR _Hi = MAXX ( _Shares, [@Value] )
			VAR _Lo3 = ROUND ( _Lo, 3 )
			VAR _Hi3 = ROUND ( _Hi, 3 )
			VAR _LoNum = IF ( _Lo3 = INT ( _Lo3 ), FORMAT ( _Lo3, "#,0" ), FORMAT ( _Lo3, "#,0.###" ) )
			VAR _HiNum = IF ( _Hi3 = INT ( _Hi3 ), FORMAT ( _Hi3, "#,0" ), FORMAT ( _Hi3, "#,0.###" ) )
			VAR _Lo1 = ROUND ( _Lo, 1 )
			VAR _Hi1 = ROUND ( _Hi, 1 )
			VAR _LoPct = IF ( _Lo1 = INT ( _Lo1 ), FORMAT ( _Lo1, "#,0" ), FORMAT ( _Lo1, "#,0.0" ) )
			VAR _HiPct = IF ( _Hi1 = INT ( _Hi1 ), FORMAT ( _Hi1, "#,0" ), FORMAT ( _Hi1, "#,0.0" ) )
			VAR _LoText =
			    SWITCH (
			        _WorstUnit,
			        "pct", _LoPct & "%",
			        "days", _LoNum & " days",
			        "gbp", "£" & _LoNum,
			        "perMonth", _LoNum & " / month",
			        "level", FORMAT ( _Lo, "0.0" ) & " of 5",
			        _LoNum
			    )
			VAR _HiText =
			    SWITCH (
			        _WorstUnit,
			        "pct", _HiPct & "%",
			        "days", _HiNum & " days",
			        "gbp", "£" & _HiNum,
			        "perMonth", _HiNum & " / month",
			        "level", FORMAT ( _Hi, "0.0" ) & " of 5",
			        _HiNum
			    )
			VAR _Own = [Domain Score]
			VAR _EstateAverage = CALCULATE ( [Domain Score], REMOVEFILTERS ( 'Team'[TeamKey], 'Team'[TeamName], 'Team'[SortOrder], 'Team'[LabName], 'Lab'[LabKey], 'Lab'[LabName], 'Lab'[SortOrder], 'Lab'[LabCode], 'Lab'[LabColour] ) )
			VAR _Diff = _Own - _EstateAverage
			RETURN
			    IF (
			        HASONEVALUE ( 'Domain'[DomainKey] ),
			        SWITCH (
			            TRUE (),
			            ISBLANK ( _WorstKey ) || _TeamCount = 0, "There are no team figures to compare for " & _ScopeName & ".",
			            _TeamCount > 1 && _WorstAgg = "sum",
			                _Top2Names & " carry " & _Share & " per cent of " & LOWER ( _WorstName ) & " across " & _ScopeName & ".",
			            _TeamCount > 1,
			                _WorstName & " ranges from " & _LoText & " to " & _HiText & " across teams in " & _ScopeName & ".",
			            _Diff >= 0, _ScopeName & " scores " & _Diff & " points above the estate average for this domain.",
			            _ScopeName & " scores " & ABS ( _Diff ) & " points below the estate average for this domain."
			        )
			    )
		displayFolder: Headlines and read-outs
		lineageTag: f63d3272-d689-52d1-bee9-0340bb770ea9

	/// Domain read-out 3: trend direction over the selected period, from the domain score.
	measure 'Read Out 3' =
			VAR _Points = [Selected Quarters]
			VAR _Diff = [Score Delta over Period]
			RETURN
			    IF (
			        HASONEVALUE ( 'Domain'[DomainKey] ) && NOT ISBLANK ( _Diff ),
			        IF (
			            _Diff > 2,
			            "Trend is improving, up " & _Diff & " points over the last " & _Points & " quarters.",
			            IF (
			                _Diff < -2,
			                "Trend is declining, down " & ABS ( _Diff ) & " points over the last " & _Points & " quarters.",
			                "Trend is broadly flat over the last " & _Points & " quarters."
			            )
			        )
			    )
		displayFolder: Headlines and read-outs
		lineageTag: 1da0f509-0e73-5371-8dfe-f2c962ad220f

	/// Footer left: "Platform Health · <report> · <page>" from the disconnected Page table, which each page's Page[PageKey] filter cuts to one row.
	measure 'Page Footer Left' =
			VAR _Report = SELECTEDVALUE ( 'Page'[ReportName] )
			VAR _Page = SELECTEDVALUE ( 'Page'[PageName] )
			RETURN
			    IF ( NOT ISBLANK ( _Page ), "Platform Health · " & _Report & " · " & _Page )
		displayFolder: Page footer (page-footer, one a page)
		lineageTag: 610b91cc-1c4c-5809-bd59-ffe76d8fe1c2

	/// Footer right: the source systems behind the metrics in the page's domain (every core domain where no single domain is filtered), most recently refreshed first, at most five then "+N more". SourceRefresh is disconnected; TREATAS matches its System to Metric[SourceSystem]. Refresh reads "today 06:00" or "yesterday 18:00" against Config[RefreshDate], else the date as "30 Jun".
	measure 'Page Sources Refreshed' =
			VAR _DomainPage = ISFILTERED ( 'Domain'[DomainKey] ) && HASONEVALUE ( 'Domain'[DomainKey] )
			VAR _Systems =
			    CALCULATETABLE (
			        SUMMARIZE ( 'Metric', 'Metric'[SourceSystem] ),
			        FILTER ( VALUES ( 'Domain'[IsCore] ), _DomainPage || 'Domain'[IsCore] = TRUE () )
			    )
			VAR _Today = INT ( MAX ( 'Config'[RefreshDate] ) )
			VAR _Rows =
			    ADDCOLUMNS (
			        CALCULATETABLE ( 'SourceRefresh', TREATAS ( _Systems, 'SourceRefresh'[System] ) ),
			        "@Label",
			            'SourceRefresh'[Short] & " "
			                & SWITCH (
			                    INT ( 'SourceRefresh'[LastRefresh] ),
			                    _Today, "today " & FORMAT ( 'SourceRefresh'[LastRefresh], "hh:nn" ),
			                    _Today - 1, "yesterday " & FORMAT ( 'SourceRefresh'[LastRefresh], "hh:nn" ),
			                    FORMAT ( 'SourceRefresh'[LastRefresh], "d mmm" )
			                )
			    )
			VAR _Count = COUNTROWS ( _Rows )
			VAR _Top = TOPN ( 5, _Rows, 'SourceRefresh'[LastRefresh], DESC, 'SourceRefresh'[System], ASC )
			RETURN
			    IF (
			        _Count > 0,
			        "Sources: " & CONCATENATEX ( _Top, [@Label], " · ", 'SourceRefresh'[LastRefresh], DESC, 'SourceRefresh'[System], ASC )
			            & IF ( _Count > 5, " · +" & ( _Count - 5 ) & " more" )
			    )
		displayFolder: Page footer (page-footer, one a page)
		lineageTag: 9f3dd47d-6ddb-5a0f-93ad-1a8639dbdcdb

	/// Start: the composite at the first quarter of the period; delta: the domain's change over the period divided by the core domain count; end: the composite now. The composite here is the unrounded mean of core domain scores, so the steps add up.
	measure 'Step Value' =
			VAR _Kind = SELECTEDVALUE ( 'MovementStep'[Kind] )
			VAR _StepDomain = SELECTEDVALUE ( 'MovementStep'[DomainKey] )
			VAR _NowKey = [Score Quarter Key]
			VAR _StartKey = _NowKey - [Selected Quarters] + 1
			VAR _TeamDomain =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'ScoreFact', 'ScoreFact'[QuarterKey], 'ScoreFact'[TeamKey], 'Domain'[DomainKey], 'Domain'[SortOrder] ),
			            "@Domain", INT ( CALCULATE ( AVERAGE ( 'ScoreFact'[Score] ) ) + 0.5 )
			        ),
			        REMOVEFILTERS ( 'Quarter' ),
			        'Quarter'[QuarterKey] IN { _StartKey, _NowKey },
			        'ScoreFact'[IsScored] = TRUE (),
			        REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ),
			        REMOVEFILTERS ( 'Domain'[DomainKey], 'Domain'[DomainName], 'Domain'[Question], 'Domain'[SortOrder], 'Domain'[DomainGroup], 'Domain'[DomainGroupName] ),
			        'Domain'[IsCore] = TRUE ()
			    )
			VAR _Domains =
			    GROUPBY (
			        _TeamDomain,
			        'ScoreFact'[QuarterKey], 'Domain'[DomainKey], 'Domain'[SortOrder],
			        "@Mean", AVERAGEX ( CURRENTGROUP (), [@Domain] )
			    )
			VAR _Start = AVERAGEX ( FILTER ( _Domains, 'ScoreFact'[QuarterKey] = _StartKey ), INT ( [@Mean] + 0.5 ) )
			VAR _End = AVERAGEX ( FILTER ( _Domains, 'ScoreFact'[QuarterKey] = _NowKey ), INT ( [@Mean] + 0.5 ) )
			VAR _DomainStart =
			    MAXX ( FILTER ( _Domains, 'ScoreFact'[QuarterKey] = _StartKey && 'Domain'[DomainKey] = _StepDomain ), INT ( [@Mean] + 0.5 ) )
			VAR _DomainEnd =
			    MAXX ( FILTER ( _Domains, 'ScoreFact'[QuarterKey] = _NowKey && 'Domain'[DomainKey] = _StepDomain ), INT ( [@Mean] + 0.5 ) )
			RETURN
			    SWITCH (
			        _Kind,
			        "start", IF ( _StartKey >= 1, _Start ),
			        "delta",
			            IF (
			                _StartKey >= 1 && NOT ISBLANK ( _DomainStart ) && NOT ISBLANK ( _DomainEnd ),
			                DIVIDE ( _DomainEnd - _DomainStart, [Core Domains] )
			            ),
			        "end", _End
			    )
		displayFolder: Movement waterfall (one MovementStep row in context)
		lineageTag: 1c6a0cf8-58d5-597a-8970-3d9b9838bf64

	/// The composite after this step: the start plus every delta up to and including this one; equals [Step Value] on the start and end rows.
	measure 'Step Running' =
			VAR _ThisStep = SELECTEDVALUE ( 'MovementStep'[Step] )
			VAR _Kind = SELECTEDVALUE ( 'MovementStep'[Kind] )
			VAR _NowKey = [Score Quarter Key]
			VAR _StartKey = _NowKey - [Selected Quarters] + 1
			VAR _TeamDomain =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( 'ScoreFact', 'ScoreFact'[QuarterKey], 'ScoreFact'[TeamKey], 'Domain'[DomainKey], 'Domain'[SortOrder] ),
			            "@Domain", INT ( CALCULATE ( AVERAGE ( 'ScoreFact'[Score] ) ) + 0.5 )
			        ),
			        REMOVEFILTERS ( 'Quarter' ),
			        'Quarter'[QuarterKey] IN { _StartKey, _NowKey },
			        'ScoreFact'[IsScored] = TRUE (),
			        REMOVEFILTERS ( 'Metric'[MetricKey], 'Metric'[MetricName], 'Metric'[SortOrder], 'Metric'[DomainName] ),
			        REMOVEFILTERS ( 'Domain'[DomainKey], 'Domain'[DomainName], 'Domain'[Question], 'Domain'[SortOrder], 'Domain'[DomainGroup], 'Domain'[DomainGroupName] ),
			        'Domain'[IsCore] = TRUE ()
			    )
			VAR _Domains =
			    GROUPBY (
			        _TeamDomain,
			        'ScoreFact'[QuarterKey], 'Domain'[DomainKey], 'Domain'[SortOrder],
			        "@Mean", AVERAGEX ( CURRENTGROUP (), [@Domain] )
			    )
			VAR _Start = AVERAGEX ( FILTER ( _Domains, 'ScoreFact'[QuarterKey] = _StartKey ), INT ( [@Mean] + 0.5 ) )
			VAR _End = AVERAGEX ( FILTER ( _Domains, 'ScoreFact'[QuarterKey] = _NowKey ), INT ( [@Mean] + 0.5 ) )
			VAR _Moved =
			    SUMX (
			        FILTER ( _Domains, 'Domain'[SortOrder] <= _ThisStep ),
			        IF ( 'ScoreFact'[QuarterKey] = _NowKey, 1, -1 ) * INT ( [@Mean] + 0.5 )
			    )
			RETURN
			    IF (
			        HASONEVALUE ( 'MovementStep'[Step] ),
			        IF ( _Kind = "end", _End, IF ( _StartKey >= 1, _Start + DIVIDE ( _Moved, [Core Domains] ) ) )
			    )
		displayFolder: Movement waterfall (one MovementStep row in context)
		lineageTag: e222876f-2672-5b34-a07c-9a8fee580cf8

	/// People in context.
	measure Headcount = COUNTROWS ( 'Person' )
		displayFolder: People structure (Person, Skill and PersonSkill; the Structure and skills page)
		lineageTag: 5d63c389-5ec8-5c1d-89b0-7d8649a56662

	/// Contractors in context; BLANK where there are none.
	measure Contractors = CALCULATE ( COUNTROWS ( 'Person' ), 'Person'[Employment] = "contractor" )
		displayFolder: People structure (Person, Skill and PersonSkill; the Structure and skills page)
		lineageTag: d886c182-9e6e-5d96-98dd-b9b05e014bcf

	/// Contractor share of the people in context, a whole percentage (contractorPct).
	measure 'Contractor Pct' =
			VAR _People = [Headcount]
			RETURN
			    IF ( _People > 0, INT ( 100 * DIVIDE ( [Contractors], _People ) + 0.5 ) )
		displayFolder: People structure (Person, Skill and PersonSkill; the Structure and skills page)
		lineageTag: 44b7acdf-f66b-52ae-9ea3-51a1f65a1a08

	/// A leader's span on the leadership chart (spanOf): everyone for the platform lead (LeadLevel 1), the lab for a lab lead (2), the team for a team lead (3). Reads the one Person row in context.
	measure 'Span Headcount' =
			VAR _Level = SELECTEDVALUE ( 'Person'[LeadLevel] )
			VAR _Lab = SELECTEDVALUE ( 'Person'[LabKey] )
			VAR _Team = SELECTEDVALUE ( 'Person'[TeamKey] )
			RETURN
			    SWITCH (
			        _Level,
			        1, CALCULATE ( [Headcount], REMOVEFILTERS ( 'Person' ) ),
			        2, CALCULATE ( [Headcount], REMOVEFILTERS ( 'Person' ), 'Person'[LabKey] = _Lab ),
			        3, CALCULATE ( [Headcount], REMOVEFILTERS ( 'Person' ), 'Person'[TeamKey] = _Team )
			    )
		displayFolder: People structure (Person, Skill and PersonSkill; the Structure and skills page)
		lineageTag: ea6a6048-1049-541d-8ac2-591915d58779

	/// The contractor share of the same span.
	measure 'Span Contractor Pct' =
			VAR _Level = SELECTEDVALUE ( 'Person'[LeadLevel] )
			VAR _Lab = SELECTEDVALUE ( 'Person'[LabKey] )
			VAR _Team = SELECTEDVALUE ( 'Person'[TeamKey] )
			RETURN
			    SWITCH (
			        _Level,
			        1, CALCULATE ( [Contractor Pct], REMOVEFILTERS ( 'Person' ) ),
			        2, CALCULATE ( [Contractor Pct], REMOVEFILTERS ( 'Person' ), 'Person'[LabKey] = _Lab ),
			        3, CALCULATE ( [Contractor Pct], REMOVEFILTERS ( 'Person' ), 'Person'[TeamKey] = _Team )
			    )
		displayFolder: People structure (Person, Skill and PersonSkill; the Structure and skills page)
		lineageTag: b62b6ba9-26e2-5551-96a4-dba8b7a6a2fe

	/// Holders of the skill in context among the people in context; BLANK where none.
	measure 'Skill Count' = COUNTROWS ( 'PersonSkill' )
		displayFolder: People structure (Person, Skill and PersonSkill; the Structure and skills page)
		lineageTag: e3d7deb9-e5a0-5f8f-b857-4317d41a7cde

	/// Holders of the skill in context across the estate, whatever the lab grouping or slicers.
	measure 'Skill Estate Count' = CALCULATE ( [Skill Count], REMOVEFILTERS ( 'Person' ) )
		displayFolder: People structure (Person, Skill and PersonSkill; the Structure and skills page)
		lineageTag: ab64db59-2f66-59f2-ac8d-4f451675870a

	/// Estate-wide depth of the skill in context, in words (skillFlagFor): one holder, two, or three and more.
	measure 'Skill Flag' =
			VAR _Holders = [Skill Estate Count]
			RETURN
			    IF (
			        NOT ISBLANK ( _Holders ),
			        SWITCH ( TRUE (), _Holders <= 1, "Single-person", _Holders = 2, "Thin", "Covered" )
			    )
		displayFolder: People structure (Person, Skill and PersonSkill; the Structure and skills page)
		lineageTag: c440a91c-cdef-5976-9db6-df47e40bd05f

	/// Critical skills held by one or two people across the estate (THIN_SKILLS); BLANK where none.
	measure 'Thin Skills' = COUNTROWS ( FILTER ( ALL ( 'Skill'[SkillKey] ), CALCULATE ( [Skill Estate Count] ) <= 2 ) )
		displayFolder: People structure (Person, Skill and PersonSkill; the Structure and skills page)
		lineageTag: 9b4a59f6-e72a-56c5-9c1e-edc892203120

	/// Structure and skills headline (PeopleStructurePage). Estate-wide: ignores every slicer.
	measure 'People Structure Headline' =
			VAR _People = CALCULATE ( [Headcount], REMOVEFILTERS ( 'Person' ) )
			VAR _Pct = CALCULATE ( [Contractor Pct], REMOVEFILTERS ( 'Person' ) )
			VAR _Thin = COALESCE ( [Thin Skills], 0 )
			RETURN
			    _People & " people across four labs, " & _Pct & "% contractors; " & _Thin & " critical skill"
			        & IF ( _Thin = 1, "", "s" ) & " rest" & IF ( _Thin = 1, "s", "" ) & " on one or two people."
		displayFolder: People structure (Person, Skill and PersonSkill; the Structure and skills page)
		lineageTag: bb38e086-26fb-5085-ae83-b5dc8b109323

