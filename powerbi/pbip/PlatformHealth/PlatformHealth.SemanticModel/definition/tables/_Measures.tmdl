	/// True for the proposed domains, Cost and Operability.
	measure 'Is Proposed' = IF ( HASONEVALUE ( 'Domain'[DomainKey] ), SELECTEDVALUE ( 'Domain'[IsCore] ) == FALSE () )
		displayFolder: Build measures
