	/// [Metric Value] 2 quarters before the current one: sparkline point q4.
	measure 'Metric Value Q4' =
			VAR _K = [Score Quarter Key] - 2
			RETURN
			    IF ( _K >= 1, CALCULATE ( [Metric Value], REMOVEFILTERS ( 'Quarter' ), 'Quarter'[QuarterKey] = _K ) )
		displayFolder: Build measures
