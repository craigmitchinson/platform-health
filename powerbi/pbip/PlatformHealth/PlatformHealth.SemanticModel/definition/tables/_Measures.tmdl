	/// [Metric Value] 1 quarter before the current one: sparkline point q5.
	measure 'Metric Value Q5' =
			VAR _K = [Score Quarter Key] - 1
			RETURN
			    IF ( _K >= 1, CALCULATE ( [Metric Value], REMOVEFILTERS ( 'Quarter' ), 'Quarter'[QuarterKey] = _K ) )
		displayFolder: Build measures
		lineageTag: 02651ebb-9c71-5dd8-9e09-26a46c0f7771

	/// Full name of the ingestion mode, blank where the domain has no metric in that mode.
	measure 'Mode Label' =
			IF (
			    COUNTROWS ( 'Metric' ) > 0,
			    SWITCH (
			        SELECTEDVALUE ( 'Metric'[IngestionMode] ),
			        "sql", "SQL direct query",
			        "semantic", "Semantic model",
			        "spreadsheet", "Spreadsheet",
			        "csv", "CSV drop",
			        "api", "API"
			    )
			)
		displayFolder: Build measures
		lineageTag: b5433b1f-a579-5fa7-b11d-773b81f95aaa

	/// The least ready source among the metrics in context.
	measure 'Worst Readiness' =
			VAR _A = CALCULATE ( COUNTROWS ( 'Metric' ), 'Metric'[Readiness] = "aspirational" )
			VAR _P = CALCULATE ( COUNTROWS ( 'Metric' ), 'Metric'[Readiness] = "partial" )
			RETURN
			    IF ( COUNTROWS ( 'Metric' ) > 0, SWITCH ( TRUE (), _A > 0, "aspirational", _P > 0, "partial", "live" ) )
		displayFolder: Build measures
		lineageTag: b88dbaf5-a9c7-581d-b7e6-d3c949131e60

	/// Metrics whose readiness is live, for the domain and mode in context.
	measure 'Live Metrics' = CALCULATE ( COUNTROWS ( 'Metric' ), 'Metric'[Readiness] = "live" )
		formatString: 0
		displayFolder: Build measures
		lineageTag: 016860c2-39e8-5ff9-a69b-4d63b71d6db1

