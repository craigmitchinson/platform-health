		displayFolder: Build measures
		lineageTag: f2e17ef7-ff82-5a63-bfdc-9ad54cf42abc

	/// [Metric Value] 3 quarters before the current one: sparkline point q3.
	measure 'Metric Value Q3' =
			VAR _K = [Score Quarter Key] - 3
