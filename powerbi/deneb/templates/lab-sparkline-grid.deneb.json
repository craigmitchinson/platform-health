      "value": 170
    },
    {
      "name": "headerHeight",
      "value": 40
    },
    {
      "name": "cellGap",
      "value": 6
    }
  ],
  "title": {
    "text": {
      "expr": "title"
    },
    "subtitle": "Cells shaded by this quarter's band: Healthy 80 and above · Watch 60 to 79 · Act below 60",
    "font": "JetBrains Mono, Consolas, monospace",
    "fontSize": 12.5,
    "fontWeight": 600,
    "color": {
      "expr": "muted"
    },
    "anchor": "start",
    "offset": 6,
    "subtitleFont": "Segoe UI, wf_segoe-ui_normal, Arial, sans-serif",
    "subtitleFontSize": 12,
    "subtitleColor": {
      "expr": "muted"
    },
    "subtitlePadding": 4
  },
  "transform": [
    {
      "calculate": "indexof(domainOrder, datum['__3__'])",
      "as": "col"
    },
    {
      "filter": "datum.col >= 0"
    },
    {
      "calculate": "indexof(labOrder, datum['__0__']) < 0 ? length(labOrder) : indexof(labOrder, datum['__0__'])",
      "as": "labIndex"
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "labRank"
        }
      ],
      "sort": [
        {
          "field": "labIndex",
          "order": "ascending"
        },
        {
          "field": "__0__",
          "order": "ascending"
        }
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "labRank",
          "as": "labCount"
        },
        {
          "op": "min",
          "field": "__6__",
          "as": "allMin"
        },
        {
          "op": "max",
          "field": "__6__",
          "as": "allMax"
        }
      ]
    },
    {
      "window": [
        {
          "op": "first_value",
          "field": "__6__",
          "as": "firstScore"
        },
        {
          "op": "last_value",
          "field": "__6__",
          "as": "lastScore"
        },
        {
          "op": "max",
          "field": "__5__",
          "as": "lastQuarter"
        },
        {
          "op": "min",
          "field": "__5__",
          "as": "firstQuarter"
        }
      ],
      "sort": [
        {
          "field": "__5__",
          "order": "ascending"
        }
      ],
      "groupby": [
        "__0__",
        "__3__"
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "calculate": "max(1, (width - labelWidth) / length(domainOrder))",
      "as": "cellW"
    },
    {
      "calculate": "max(1, (height - headerHeight) / datum.labCount)",
      "as": "cellH"
    },
    {
      "calculate": "labelWidth + datum.col * datum.cellW + cellGap / 2",
      "as": "x0"
    },
    {
      "calculate": "datum.x0 + datum.cellW - cellGap",
      "as": "x1"
    },
    {
      "calculate": "headerHeight + (datum.labRank - 1) * datum.cellH + cellGap / 2",
      "as": "y0"
    },
    {
      "calculate": "datum.y0 + datum.cellH - cellGap",
      "as": "y1"
    },
    {
      "calculate": "min(datum.allMin, 60) - 4",
      "as": "sparkLow"
    },
    {
      "calculate": "min(100, max(datum.allMax, 88) + 2)",
      "as": "sparkHigh"
    },
    {
      "calculate": "datum.y0 + 28",
      "as": "sparkTop"
    },
    {
      "calculate": "datum.y1 - 7",
      "as": "sparkBase"
    },
    {
      "calculate": "datum.x0 + 10 + (datum.x1 - datum.x0 - 22) * (datum['__5__'] - datum.firstQuarter) / max(1, datum.lastQuarter - datum.firstQuarter)",
      "as": "sx"
    },
    {
      "calculate": "datum.sparkBase - (datum.sparkBase - datum.sparkTop) * (clamp(datum['__6__'], datum.sparkLow, datum.sparkHigh) - datum.sparkLow) / (datum.sparkHigh - datum.sparkLow)",
      "as": "sy"
    },
    {
      "calculate": "datum['__7__'] === 'healthy' ? emerald : datum['__7__'] === 'watch' ? amber : datum['__7__'] === 'act' ? red : muted",
      "as": "bandKey"
    },
    {
      "calculate": "datum['__7__'] === 'healthy' ? goodFill : datum['__7__'] === 'watch' ? warnFill : datum['__7__'] === 'act' ? badFill : sage",
      "as": "bandFill"
    },
    {
      "calculate": "{'healthy': 'HEALTHY', 'watch': 'WATCH', 'act': 'ACT'}[datum['__7__']] || upper(datum['__7__'])",
      "as": "bandWord"
    },
    {
      "calculate": "datum.x0 + 10",
      "as": "scoreX"
    },
    {
      "calculate": "datum.y0 + 8",
      "as": "scoreY"
    },
    {
      "calculate": "datum.x1 - 8",
      "as": "wordX"
    },
    {
      "calculate": "isValid(datum['__1__']) && datum['__1__'] !== '' ? datum['__1__'] + '' : upper(substring(datum['__0__'] + '', 0, 2))",
      "as": "chipCode"
    },
    {
      "calculate": "isValid(datum['__2__']) && datum['__2__'] !== '' ? datum['__2__'] + '' : muted",
      "as": "chipColour"
    }
  ],
  "encoding": {
    "opacity": {
      "condition": {
        "test": "datum.__selected__ === 'off'",
        "value": 0.35
      },
      "value": 1
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum['__5__'] === datum.lastQuarter"
        }
      ],
      "params": [
