              "type": "nominal",
              "scale": null
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "font": "Fraunces, Cambria, Georgia, serif",
            "fontSize": 16,
            "fontWeight": 600,
            "color": {
              "expr": "ink"
            }
          },
          "encoding": {
            "x": {
              "field": "scoreX",
              "type": "quantitative",
              "scale": null
            },
            "y": {
              "field": "scoreY",
              "type": "quantitative",
              "scale": null
