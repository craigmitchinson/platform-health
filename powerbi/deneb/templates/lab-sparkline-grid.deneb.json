    {
      "transform": [
        {
          "filter": "datum['__5__'] === datum.lastQuarter && datum.labRank === 1"
        },
        {
          "calculate": "(datum.x0 + datum.x1) / 2",
          "as": "headX"
        },
        {
          "calculate": "headerHeight - 20",
          "as": "headY"
        },
        {
          "calculate": "indexof(datum['__4__'], ' ') > 0 ? [slice(datum['__4__'], 0, indexof(datum['__4__'], ' ')), slice(datum['__4__'], indexof(datum['__4__'], ' ') + 1)] : ['', datum['__4__']]",
          "as": "headText"
