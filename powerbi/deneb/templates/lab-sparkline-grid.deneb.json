        "color": {
          "expr": "emerald"
        },
        "fillOpacity": 0.3
      },
      "encoding": {
        "x": {
          "field": "sx",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "sy",
          "type": "quantitative",
          "scale": null
        },
