          "field": "sparkBase"
        },
        "detail": [
          {
            "field": "__0__"
          },
          {
            "field": "__3__"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 1.5,
        "color": {
          "expr": "evergreen"
        }
      },
      "encoding": {
        "x": {
          "field": "sx",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "sy",
          "type": "quantitative",
          "scale": null
        },
        "detail": [
          {
            "field": "__0__"
          },
          {
            "field": "__3__"
          }
        ],
        "order": {
          "field": "__5__",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum['__5__'] === datum.lastQuarter"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "size": 40,
            "stroke": {
