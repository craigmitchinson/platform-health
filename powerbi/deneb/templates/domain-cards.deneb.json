          "as": "cardCount"
        }
      ]
    },
    {
      "calculate": "max(1, ceil(datum.cardCount / 2))",
      "as": "cols"
    },
    {
      "calculate": "width / datum.cols",
      "as": "cardW"
    },
    {
      "calculate": "(datum.card - 1) % datum.cols",
      "as": "c0"
    },
    {
      "calculate": "(datum.c0 + 1) * datum.cardW",
      "as": "c1"
    },
    {
      "calculate": "floor((datum.card - 1) / datum.cols)",
      "as": "r0"
    },
    {
      "calculate": "datum.c0 * datum.cardW",
      "as": "cellX"
    },
    {
      "calculate": "datum.r0 * (rowH + rowGap)",
      "as": "cardTop"
    },
    {
      "calculate": "datum.cardTop + rowH",
      "as": "cardBottom"
    },
    {
      "calculate": "datum.cardTop - 6",
      "as": "cellY"
    },
    {
      "calculate": "{'healthy': 'HEALTHY', 'watch': 'WATCH', 'act': 'ACT', 'context': 'CONTEXT'}[datum['__4__']] || upper(datum['__4__'])",
      "as": "bandWord"
    },
    {
      "calculate": "datum['__4__'] === 'healthy' ? emerald : datum['__4__'] === 'watch' ? amber : datum['__4__'] === 'act' ? red : muted",
      "as": "bandKey"
    },
    {
      "calculate": "datum['__5__'] + ' ' + datum['__6__'] + ' vs ' + datum['__7__']",
      "as": "driverText"
    },
    {
      "calculate": "datum['__13__'] - datum['__12__']",
      "as": "change"
    },
    {
      "calculate": "(datum.change > 0 ? '+' : datum.change < 0 ? '−' : '±') + abs(datum.change) + (datum.change > 0 ? ' better' : datum.change < 0 ? ' worse' : ' held') ",
      "as": "changeText"
    },
    {
      "calculate": "datum.change > 0 ? emerald : datum.change < 0 ? amber : muted",
      "as": "changeColour"
    },
    {
      "calculate": "min(datum['__8__'], datum['__9__'], datum['__10__'], datum['__11__'], datum['__12__'], datum['__13__'])",
      "as": "cardMin"
    },
    {
      "calculate": "max(datum['__8__'], datum['__9__'], datum['__10__'], datum['__11__'], datum['__12__'], datum['__13__'])",
      "as": "cardMax"
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "cardMin",
          "as": "allMin"
        },
        {
          "op": "max",
          "field": "cardMax",
          "as": "allMax"
        }
      ]
    },
    {
      "calculate": "min(datum.allMin, 76) - 4",
      "as": "sparkLow"
    },
    {
      "calculate": "min(100, max(datum.allMax, 88) + 3)",
      "as": "sparkHigh"
    },
    {
      "calculate": "datum['__2__'] === true ? 0.5 : 1",
      "as": "dim"
    }
  ],
