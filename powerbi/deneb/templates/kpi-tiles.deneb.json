          "order": "ascending"
        }
      ]
    },
    {
      "filter": "datum.tile <= maxTiles"
    },
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "tiles"
        }
      ]
    },
    {
      "calculate": "datum.tile - 1",
      "as": "c0"
    },
    {
      "calculate": "datum.tile",
      "as": "c1"
    },
    {
      "calculate": "width * datum.c0 / datum.tiles",
      "as": "tileX"
    },
    {
      "calculate": "width * datum.c1 / datum.tiles",
      "as": "tileX2"
    },
    {
      "calculate": "{'pct': '%', 'days': ' days', 'perMonth': ' / month', 'level': ' of 5'}[datum['__4__']] || ''",
      "as": "suffix"
    },
    {
      "calculate": "datum['__4__'] === 'gbp' ? pbiFormat(abs(datum['__6__']), '£#,0') : format(abs(datum['__6__']), datum['__4__'] === 'level' ? '.1f' : ',') + datum.suffix",
      "as": "deltaAbs"
    },
    {
      "calculate": "(datum['__6__'] > 0 ? '▲ +' : datum['__6__'] < 0 ? '▼ −' : '±') + datum.deltaAbs + (datum['__6__'] === 0 ? ' held' : (datum['__8__'] === 'lower') === (datum['__6__'] < 0) ? ' better' : ' worse') + ' over the period'",
      "as": "deltaText"
    },
    {
      "calculate": "datum['__6__'] === 0 ? muted : (datum['__8__'] === 'lower') === (datum['__6__'] < 0) ? emerald : amber",
      "as": "deltaColour"
    },
    {
      "calculate": "datum.suffix !== '' && datum['__4__'] !== 'pct' ? replace(datum['__3__'] + '', datum.suffix, '') : datum['__3__'] + ''",
      "as": "valueNum"
    },
    {
      "calculate": "{'days': 'days', 'perMonth': 'per month', 'level': 'of 5'}[datum['__4__']] || ''",
      "as": "unitWord"
    },
    {
      "calculate": "datum.tileX + pad + length(datum.valueNum) * valueSize * 0.56 + 6",
      "as": "unitX"
    },
    {
      "calculate": "datum.unitX + length(datum.unitWord) * 7.6",
      "as": "unitEnd"
    },
    {
      "calculate": "'Target ' + datum['__9__']",
      "as": "targetText"
    },
    {
      "calculate": "compact ? datum.tileX + pad : datum.tileX2 - pad",
      "as": "targetX"
    },
    {
      "calculate": "upper(datum['__1__'])",
      "as": "kicker"
    },
    {
      "calculate": "lastindexof(substring(datum.kicker, 0, kickerFit + 1), ' ')",
      "as": "kickerBreak"
    },
    {
      "calculate": "compact && length(datum.kicker) > kickerFit && datum.kickerBreak > 0 ? [substring(datum.kicker, 0, datum.kickerBreak), substring(datum.kicker, datum.kickerBreak + 1)] : datum.kicker",
      "as": "kickerLines"
    },
    {
      "calculate": "compact ? replace(datum.deltaText, ' over the period', '') : datum.deltaText",
      "as": "deltaLine"
    },
    {
      "calculate": "{'healthy': 'HEALTHY', 'watch': 'WATCH', 'act': 'ACT', 'context': 'CONTEXT'}[datum['__7__']] || upper(datum['__7__'])",
      "as": "bandWord"
    },
    {
      "calculate": "datum['__7__'] === 'healthy' ? emerald : datum['__7__'] === 'watch' ? amber : datum['__7__'] === 'act' ? red : muted",
      "as": "bandKey"
    },
    {
      "calculate": "datum['__8__'] === 'lower' ? (datum['__2__'] <= datum['__5__'] ? 1 : datum['__5__'] / datum['__2__']) : (datum['__5__'] <= 0 || datum['__2__'] >= datum['__5__'] ? 1 : datum['__2__'] / datum['__5__'])",
      "as": "progressRaw"
    },
    {
      "calculate": "clamp(datum.progressRaw, 0, 1)",
