      "transform": [
        {
          "calculate": "[datum['__10__'], datum['__11__'], datum['__12__'], datum['__13__'], datum['__14__'], datum['__15__']]",
          "as": "quarterValues"
        },
        {
          "calculate": "sequence(0, 6)",
          "as": "quarterIndex"
        },
        {
          "flatten": [
            "quarterValues",
            "quarterIndex"
          ],
          "as": [
            "quarterValue",
            "qi"
          ]
        },
        {
          "joinaggregate": [
            {
              "op": "min",
              "field": "quarterValue",
              "as": "qMin"
            },
            {
              "op": "max",
              "field": "quarterValue",
              "as": "qMax"
            }
          ],
          "groupby": [
            "__0__"
          ]
        },
        {
          "calculate": "datum.qMax > datum.qMin ? datum.qMax - datum.qMin : 1",
          "as": "qRange"
        },
        {
          "calculate": "min(datum.tileX2 - pad - 40, max(datum.tileX + (datum.tileX2 - datum.tileX) * (compact ? 0.6 : 0.56), datum.unitEnd + 12))",
          "as": "sparkX0"
        },
        {
          "calculate": "datum.tileX2 - pad",
          "as": "sparkX1"
        },
        {
          "calculate": "compact ? 46 : 56",
          "as": "sparkTop"
        },
        {
          "calculate": "valueY + 18",
          "as": "sparkBase"
        },
        {
          "calculate": "datum.sparkX0 + (datum.sparkX1 - datum.sparkX0) * datum.qi / 5",
          "as": "sx"
        },
        {
          "calculate": "datum.sparkBase - 4 - (datum.sparkBase - datum.sparkTop - 8) * (datum.qMax > datum.qMin ? (datum.quarterValue - datum.qMin) / datum.qRange : 0.5)",
          "as": "sy"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "area",
            "color": {
              "expr": "emerald"
            }
          },
          "encoding": {
            "opacity": {
              "condition": {
                "test": "datum.__selected__ === 'off'",
                "value": 0.05
              },
              "value": 0.15
            },
            "x": {
              "field": "sx",
              "type": "quantitative",
              "scale": null
            },
            "y": {
              "field": "sy",
              "type": "quantitative",
              "scale": null
            },
            "y2": {
              "field": "sparkBase"
            },
            "detail": {
              "field": "__0__"
            }
          }
        },
        {
          "mark": {
            "type": "line",
            "strokeWidth": 1.5,
            "color": {
              "expr": "evergreen"
            }
          },
          "encoding": {
            "x": {
              "field": "sx",
              "type": "quantitative",
              "scale": null
            },
            "y": {
              "field": "sy",
              "type": "quantitative",
              "scale": null
            },
            "detail": {
              "field": "__0__"
            },
            "order": {
              "field": "qi",
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.qi === 5"
            }
          ],
          "mark": {
            "type": "circle",
            "size": 44,
            "opacity": 1,
            "stroke": {
              "expr": "surface"
            },
            "strokeWidth": 1.5
          },
          "encoding": {
            "x": {
              "field": "sx",
              "type": "quantitative",
              "scale": null
            },
            "y": {
              "field": "sy",
              "type": "quantitative",
              "scale": null
            },
            "color": {
              "field": "bandKey",
              "type": "nominal",
              "scale": null
            }
          }
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "alphabetic",
        "y": {
          "expr": "compact ? tileH - 31 : max(130, tileH - 24)"
        },
        "dx": {
          "expr": "pad"
        },
        "font": "JetBrains Mono, Consolas, monospace",
        "fontSize": {
          "expr": "compact ? 11.5 : 12.5"
        },
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "deltaLine"
        },
        "color": {
          "field": "deltaColour",
          "type": "nominal",
          "scale": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": {
          "expr": "compact ? 'left' : 'right'"
        },
        "baseline": "alphabetic",
        "y": {
          "expr": "compact ? tileH - 11 : max(130, tileH - 24)"
        },
        "fontSize": 13,
        "color": {
          "expr": "muted"
        }
      },
      "encoding": {
        "x": {
          "field": "targetX",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "targetText"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "more": 1
          }
        ]
      },
      "transform": [
        {
          "filter": "moreCount > 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "alphabetic",
        "x": {
          "expr": "width - 6"
        },
        "y": {
          "expr": "height - 4"
        },
        "font": "JetBrains Mono, Consolas, monospace",
        "fontSize": 12.5,
        "fontWeight": 600,
        "color": {
          "expr": "muted"
        },
        "text": {
          "expr": "'+' + moreCount + ' more in the heat below'"
        }
      },
      "encoding": {
        "x": null,
        "tooltip": null,
        "opacity": null
      }
    }
  ]
}
