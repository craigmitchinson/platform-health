    "anchor": "start",
    "offset": 6
  },
  "transform": [
    {
      "calculate": "toNumber(datum['__0__'])",
      "as": "lvl"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "pos"
        }
      ],
      "groupby": [
        "lvl"
      ],
      "sort": [
        {
          "field": "__1__",
          "order": "ascending"
        }
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "n"
        }
      ],
      "groupby": [
        "lvl"
      ]
    },
    {
      "calculate": "(datum.pos - 1) / datum.n",
      "as": "x0"
    },
    {
      "calculate": "datum.pos / datum.n",
      "as": "x1"
    },
    {
      "calculate": "(datum.pos - 0.5) / datum.n",
      "as": "xc"
    },
    {
      "calculate": "datum.lvl === 1 ? 0 : datum.lvl === 2 ? 54 : 118",
      "as": "top"
    },
    {
      "calculate": "datum.top + (datum.lvl === 1 ? 34 : datum.lvl === 2 ? 44 : 50)",
      "as": "bottom"
    },
    {
      "calculate": "datum.top - 10",
      "as": "mid"
    },
    {
      "calculate": "datum.top - 20",
      "as": "parentBottom"
    },
    {
      "calculate": "datum.top + (datum.lvl === 3 ? 13 : 15)",
      "as": "roleY"
    },
    {
      "calculate": "datum.top + (datum.lvl === 1 ? 28 : datum.lvl === 2 ? 34 : 43)",
      "as": "spanY"
    },
    {
      "calculate": "datum.top + 28",
      "as": "nameY"
    },
    {
      "calculate": "upper(datum['__3__'] + '')",
      "as": "roleText"
    },
    {
      "calculate": "format(datum['__7__'], ',') + ' people' + (datum.lvl < 3 ? ' · ' + format(datum['__8__'], 'd') + '% contractors' : '')",
      "as": "spanText"
    },
    {
      "calculate": "isValid(datum['__5__']) && datum['__5__'] !== '' ? datum['__5__'] + '' : ''",
      "as": "chipCode"
    },
    {
      "calculate": "isValid(datum['__6__']) && datum['__6__'] !== '' ? datum['__6__'] + '' : muted",
      "as": "chipColour"
    }
  ],
