  "title": {
    "text": {
      "expr": "title"
    },
    "subtitle": "People holding each skill · thin is one or two people",
    "font": "JetBrains Mono, Consolas, monospace",
    "fontSize": 12.5,
    "fontWeight": 600,
    "color": {
      "expr": "muted"
    },
    "anchor": "start",
    "offset": 6,
    "subtitleFont": "Segoe UI, wf_segoe-ui_normal, Arial, sans-serif",
    "subtitleFontSize": 12,
    "subtitleColor": {
      "expr": "muted"
    },
    "subtitlePadding": 4
  },
  "transform": [
    {
      "calculate": "indexof(labOrder, datum['__1__']) < 0 ? length(labOrder) : indexof(labOrder, datum['__1__'])",
      "as": "labPos"
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "labRank"
        }
      ],
      "sort": [
        {
          "field": "labPos",
          "order": "ascending"
        },
        {
          "field": "__1__",
          "order": "ascending"
        }
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "distinct",
          "field": "__1__",
          "as": "nLabs"
        }
      ]
    },
    {
      "calculate": "isValid(datum['__5__']) ? toNumber(datum['__5__']) : 0",
      "as": "estate"
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "skillRank"
        }
      ],
      "sort": [
        {
          "field": "estate",
          "order": "ascending"
        },
        {
          "field": "__0__",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "isValid(datum['__2__']) && datum['__2__'] !== '' ? datum['__2__'] + '' : upper(substring(datum['__1__'] + '', 0, 2))",
      "as": "chipCode"
    },
    {
      "calculate": "isValid(datum['__3__']) && datum['__3__'] !== '' ? datum['__3__'] + '' : muted",
      "as": "chipColour"
    },
    {
      "calculate": "isValid(datum['__4__']) ? toNumber(datum['__4__']) : 0",
      "as": "labCount"
    },
    {
      "fold": [
        "labCount",
        "estate"
      ],
      "as": [
        "column",
        "cnt"
      ]
    },
    {
      "calculate": "datum.column === 'estate' ? datum.nLabs : datum.labRank - 1",
      "as": "colIdx"
    },
    {
      "calculate": "datum.colIdx + 1",
      "as": "colEnd"
    },
    {
      "calculate": "datum.colIdx + 0.5",
      "as": "colMid"
    },
    {
      "calculate": "datum.cnt === 0 ? 'none' : datum.cnt <= 2 ? 'thin' : 'covered'",
      "as": "depth"
    },
    {
      "calculate": "datum.depth === 'thin' ? datum.cnt + '  thin' : datum.cnt + ''",
      "as": "cellText"
    },
    {
      "calculate": "datum.column === 'estate' ? 'Estate' : datum['__1__']",
      "as": "columnLabel"
    }
  ],
  "encoding": {
    "y": {
      "field": "__0__",
      "type": "nominal",
      "sort": {
        "field": "skillRank",
        "op": "min",
        "order": "ascending"
      },
      "scale": {
        "range": [
          {
            "expr": "headH"
          },
          {
            "expr": "height"
          }
        ],
        "paddingInner": 0.16,
        "paddingOuter": 0
      },
      "axis": {
        "title": null,
        "orient": "left",
