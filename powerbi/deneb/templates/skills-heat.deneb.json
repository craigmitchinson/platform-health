        "field": "__0__",
        "title": "Skill"
      },
      {
        "field": "columnLabel",
        "title": "Where"
      },
      {
        "field": "cnt",
        "title": "People"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 5,
        "xOffset": 2,
        "x2Offset": -2
      },
      "encoding": {
        "x": {
          "field": "colIdx",
          "type": "quantitative",
          "scale": {
            "nice": false,
            "zero": true,
            "range": [
              0,
              {
                "expr": "max(0, width - flagW - 8)"
              }
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "colEnd"
        },
        "color": {
          "condition": [
            {
              "test": "datum.depth === 'none'",
              "value": {
                "expr": "cream"
              }
            },
            {
              "test": "datum.depth === 'thin'",
              "value": {
                "expr": "warnFill"
              }
            }
          ],
          "value": {
            "expr": "sage"
          }
        }
      }
    },
    {
      "mark": {
        "type": "rect",
        "x": {
          "expr": "scale('x', datum.colIdx) + 2"
        },
        "x2": {
          "expr": "scale('x', datum.colIdx) + 5"
        },
        "cornerRadiusTopLeft": 3,
        "cornerRadiusBottomLeft": 3
      },
      "encoding": {
        "color": {
          "condition": [
            {
              "test": "datum.depth === 'none'",
              "value": {
                "expr": "line"
              }
            },
            {
              "test": "datum.depth === 'thin'",
              "value": {
                "expr": "amber"
              }
            }
          ],
          "value": {
            "expr": "brandSoft"
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": 700
      },
      "encoding": {
        "x": {
          "field": "colMid",
          "type": "quantitative"
        },
        "text": {
          "field": "cellText"
        },
        "color": {
          "condition": {
            "test": "datum.depth === 'none'",
            "value": {
              "expr": "muted"
            }
          },
          "value": {
            "expr": "ink"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.column === 'labCount'"
        },
        {
          "aggregate": [
            {
              "op": "min",
              "field": "colIdx",
              "as": "colIdx"
            }
          ],
          "groupby": [
            "__1__",
            "chipCode",
            "chipColour"
          ]
        }
      ],
      "encoding": {
        "y": null,
        "tooltip": null
      },
      "layer": [
        {
          "mark": {
            "type": "rect",
            "cornerRadius": 5,
            "x": {
              "expr": "scale('x', datum.colIdx + 0.5) - 13"
            },
            "x2": {
              "expr": "scale('x', datum.colIdx + 0.5) + 13"
            },
            "y": 4,
            "y2": 21
          },
          "encoding": {
            "color": {
              "field": "chipColour",
              "type": "nominal",
              "scale": null
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "x": {
              "expr": "scale('x', datum.colIdx + 0.5)"
            },
            "y": 12.5,
            "align": "center",
            "baseline": "middle",
            "font": "JetBrains Mono, Consolas, monospace",
            "fontSize": 10,
            "fontWeight": 700,
            "color": {
              "expr": "surface"
            }
          },
          "encoding": {
            "text": {
              "field": "chipCode"
            }
          }
        }
      ]
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "nLabs",
              "as": "nLabs"
            }
          ]
        }
      ],
      "encoding": {
        "y": null,
        "tooltip": null
      },
      "layer": [
        {
          "mark": {
            "type": "text",
            "x": {
              "expr": "scale('x', datum.nLabs + 0.5)"
            },
            "y": 12.5,
            "align": "center",
            "baseline": "middle",
            "font": "JetBrains Mono, Consolas, monospace",
            "fontSize": 10.5,
            "letterSpacing": 0.6,
            "color": {
              "expr": "muted"
            }
          },
          "encoding": {
            "text": {
              "value": "TOTAL"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "x": {
              "expr": "width - flagW / 2"
            },
            "y": 12.5,
            "align": "center",
            "baseline": "middle",
            "font": "JetBrains Mono, Consolas, monospace",
            "fontSize": 10.5,
            "letterSpacing": 0.6,
            "color": {
              "expr": "muted"
            }
          },
          "encoding": {
            "text": {
              "value": "DEPTH"
            }
          }
        }
      ]
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "skillRank",
              "as": "skillRank"
            }
          ],
          "groupby": [
            "__0__",
            "__6__"
          ]
        },
        {
          "calculate": "datum['__6__'] === 'Single-person' ? 'single' : datum['__6__'] === 'Thin' ? 'thin' : 'covered'",
          "as": "flagKey"
        }
      ],
      "encoding": {
        "tooltip": [
          {
            "field": "__0__",
            "title": "Skill"
          },
          {
            "field": "__6__",
            "title": "Depth"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rect",
            "cornerRadius": 10,
            "x": {
              "expr": "width - flagW + 4"
            },
            "x2": {
              "expr": "width - 2"
            },
            "y": {
              "expr": "scale('y', datum['__0__']) + bandwidth('y') / 2 - 10"
            },
            "y2": {
              "expr": "scale('y', datum['__0__']) + bandwidth('y') / 2 + 10"
            }
          },
          "encoding": {
            "y": null,
            "color": {
              "condition": [
                {
                  "test": "datum.flagKey === 'single'",
                  "value": {
                    "expr": "badFill"
                  }
                },
                {
                  "test": "datum.flagKey === 'thin'",
                  "value": {
                    "expr": "warnFill"
                  }
                }
              ],
              "value": {
                "expr": "goodFill"
              }
            }
          }
        },
        {
          "mark": {
            "type": "circle",
            "size": 50,
            "x": {
              "expr": "width - flagW + 15"
            },
            "y": {
              "expr": "scale('y', datum['__0__']) + bandwidth('y') / 2"
            }
          },
          "encoding": {
            "y": null,
            "color": {
              "condition": [
                {
                  "test": "datum.flagKey === 'single'",
                  "value": {
                    "expr": "red"
                  }
                },
                {
                  "test": "datum.flagKey === 'thin'",
                  "value": {
                    "expr": "amber"
                  }
                }
              ],
              "value": {
                "expr": "emerald"
              }
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "x": {
              "expr": "width - flagW + 24"
            },
            "y": {
              "expr": "scale('y', datum['__0__']) + bandwidth('y') / 2"
            },
            "align": "left",
            "baseline": "middle",
            "font": "JetBrains Mono, Consolas, monospace",
            "fontSize": 10.5,
            "fontWeight": 600,
            "color": {
              "expr": "ink"
            }
          },
          "encoding": {
            "y": null,
            "text": {
              "field": "__6__"
