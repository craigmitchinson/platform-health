        }
      },
      "encoding": {
        "y": {
          "field": "dotY",
          "type": "quantitative",
          "scale": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "x": {
          "expr": "indent"
        },
        "align": "left",
        "baseline": "top",
        "fontSize": 13.5,
        "lineHeight": {
          "expr": "lineH"
        },
        "dy": 2,
        "color": {
          "expr": "ink"
        },
        "limit": {
          "expr": "max(40, width - indent)"
        }
      },
      "encoding": {
        "y": {
          "field": "lineY",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "lines"
        }
      }
    }
  ]
