  "description": "One card per lab in a row of four: name, lead, composite score, band pill, teams by band, and a six-quarter composite sparkline.",
  "data": {
    "name": "dataset"
  },
  "width": "container",
  "height": "container",
  "background": "transparent",
  "params": [
    {
      "name": "evergreen",
      "expr": "pbiColor(0)"
    },
    {
      "name": "emerald",
      "expr": "pbiColor(1)"
    },
    {
      "name": "sage",
      "value": "#DCE8E0"
    },
    {
      "name": "amber",
      "expr": "pbiColor(3)"
    },
    {
      "name": "red",
      "expr": "pbiColor(4)"
    },
    {
      "name": "ink",
      "expr": "pbiColor(0)"
    },
    {
      "name": "muted",
      "expr": "pbiColor(6)"
    },
    {
      "name": "line",
      "expr": "pbiColor(8)"
    },
    {
      "name": "surface",
      "value": "#FFFFFF"
    },
    {
      "name": "cream",
      "value": "#F7F6F2"
    },
    {
      "name": "goodFill",
      "value": "#DDF0E8"
    },
    {
      "name": "warnFill",
      "value": "#F5EAD6"
    },
    {
      "name": "badFill",
      "value": "#F3E0DA"
    },
    {
      "name": "labOrder",
      "value": [
        "core",
        "customer",
        "payments",
        "data"
      ]
    },
    {
      "name": "cardGap",
      "value": 16
    },
    {
      "name": "cardW",
      "expr": "max(1, (width - 3 * cardGap) / 4)"
    },
    {
      "name": "scoreY",
      "expr": "max(80, height - 50)"
    }
  ],
  "transform": [
    {
      "calculate": "isValid(datum.labOrder) && datum.labOrder !== '' ? toNumber(datum.labOrder) : indexof(labOrder, datum['__0__']) < 0 ? length(labOrder) : indexof(labOrder, datum['__0__'])",
      "as": "labRank"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "card"
        }
      ],
      "sort": [
        {
          "field": "labRank",
          "order": "ascending"
        },
        {
          "field": "__1__",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "(datum.card - 1) * (cardW + cardGap)",
      "as": "cellX"
    },
    {
      "calculate": "datum.cellX + cardW",
      "as": "cellX2"
    },
    {
      "calculate": "lower(datum['__6__'] + '')",
      "as": "bandId"
    },
    {
      "calculate": "isValid(datum['__2__']) && datum['__2__'] !== '' ? datum['__2__'] + '' : upper(substring(datum['__1__'] + '', 0, 2))",
      "as": "chipCode"
    },
    {
      "calculate": "isValid(datum['__3__']) && datum['__3__'] !== '' ? datum['__3__'] + '' : muted",
      "as": "chipColour"
    },
    {
      "calculate": "datum.cellX + 24",
      "as": "chipX"
    },
    {
      "calculate": "datum.cellX + 46",
      "as": "chipX2"
    },
    {
      "calculate": "datum.cellX + 35",
      "as": "chipMid"
    },
    {
      "calculate": "{'healthy': 'HEALTHY', 'watch': 'WATCH', 'act': 'ACT'}[datum.bandId] || upper(datum.bandId)",
      "as": "bandWord"
    },
    {
      "calculate": "datum.bandId === 'healthy' ? emerald : datum.bandId === 'watch' ? amber : datum.bandId === 'act' ? red : muted",
      "as": "bandKey"
    },
    {
      "calculate": "toNumber(datum['__7__']) + ' healthy · ' + toNumber(datum['__8__']) + ' watch · ' + toNumber(datum['__9__']) + ' act'",
      "as": "teamsText"
    },
    {
      "calculate": "[toNumber(datum['__10__']), toNumber(datum['__11__']), toNumber(datum['__12__']), toNumber(datum['__13__']), toNumber(datum['__14__']), toNumber(datum['__15__'])]",
      "as": "quarterScores"
    },
    {
      "calculate": "extent(datum.quarterScores)[0]",
      "as": "cardMin"
    },
    {
      "calculate": "extent(datum.quarterScores)[1]",
      "as": "cardMax"
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "cardMin",
          "as": "allMin"
        },
        {
          "op": "max",
          "field": "cardMax",
          "as": "allMax"
        }
      ]
    },
    {
      "calculate": "min(datum.allMin, 60) - 4",
      "as": "sparkLow"
    },
    {
      "calculate": "min(100, max(datum.allMax, 88) + 3)",
      "as": "sparkHigh"
    },
    {
      "calculate": "datum.cellX + cardW * 0.56",
      "as": "sparkX0"
    },
    {
      "calculate": "datum.cellX2 - 24",
      "as": "sparkX1"
    },
    {
      "calculate": "52",
      "as": "sparkTop"
    },
    {
      "calculate": "scoreY + 4",
      "as": "sparkBase"
    }
  ],
