        "labelFontSize": 11,
        "labelFontWeight": 600,
        "labelColor": {
          "expr": "ink"
        },
        "labelExpr": "indexof(datum.label, ' ') > 0 ? split(datum.label, ' ') : ['', datum.label]",
        "labelLineHeight": 15,
        "labelPadding": 24,
        "labelOffset": {
          "expr": "datum.value === 'Composite' ? compositeGap : 0"
        }
      }
    },
    "y": {
      "field": "__0__",
      "type": "nominal",
      "sort": {
        "field": "rowRank",
        "op": "min",
        "order": "ascending"
      },
      "scale": {
        "paddingInner": 0.18,
        "paddingOuter": 0
