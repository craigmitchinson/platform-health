            },
            "align": "center",
            "baseline": "middle",
            "font": "JetBrains Mono, Consolas, monospace",
            "fontSize": 10,
            "fontWeight": 700,
            "color": {
              "expr": "surface"
            }
          },
          "encoding": {
            "x": null,
            "y": null,
            "text": {
              "field": "chipCode"
            },
            "tooltip": null,
            "opacity": null
          }
        }
      ]
    },
    {
      "params": [
        {
          "name": "__select__",
          "select": {
            "type": "point",
            "fields": [
              "__0__",
              "__1__"
            ],
            "on": "click",
            "clear": "dblclick"
          }
        }
      ],
      "mark": {
        "type": "rect",
        "cornerRadius": 6,
        "xOffset": {
          "expr": "datum.gapShift"
        }
      },
      "encoding": {
        "color": {
          "condition": [
            {
              "test": "datum['__4__'] === 'healthy'",
              "value": {
                "expr": "goodFill"
              }
            },
            {
              "test": "datum['__4__'] === 'watch'",
              "value": {
                "expr": "warnFill"
              }
            },
            {
              "test": "datum['__4__'] === 'act'",
              "value": {
                "expr": "badFill"
              }
            }
          ],
          "value": {
            "expr": "sage"
          }
        }
      }
    },
    {
      "mark": {
        "type": "rect",
        "width": 3,
        "xOffset": {
          "expr": "1.5 - bandwidth('x') / 2 + datum.gapShift"
        },
        "cornerRadiusTopLeft": 3,
        "cornerRadiusBottomLeft": 3
      },
      "encoding": {
        "color": {
          "condition": [
            {
              "test": "datum['__4__'] === 'healthy'",
              "value": {
                "expr": "emerald"
              }
            },
            {
              "test": "datum['__4__'] === 'watch'",
              "value": {
