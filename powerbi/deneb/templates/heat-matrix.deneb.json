        "title": "Score"
      },
      {
        "field": "bandWord",
        "title": "Band"
      }
    ],
    "opacity": {
      "condition": {
        "test": "datum.__selected__ === 'off'",
        "value": 0.35
      },
      "value": 1
    }
  },
  "layer": [
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "rowRank",
              "as": "rowRank"
            }
          ],
          "groupby": [
            "__0__",
            "chipCode",
            "chipColour"
          ]
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rect",
            "cornerRadius": 4,
            "x": -170,
            "x2": -148,
            "y": {
              "expr": "scale('y', datum['__0__']) + bandwidth('y') / 2 - 9"
            },
            "y2": {
              "expr": "scale('y', datum['__0__']) + bandwidth('y') / 2 + 9"
            }
          },
          "encoding": {
