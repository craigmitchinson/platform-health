  "title": {
    "text": {
      "expr": "title"
    },
    "subtitle": "Healthy 80 and above · Watch 60 to 79 · Act below 60",
    "font": "JetBrains Mono, Consolas, monospace",
    "fontSize": 12.5,
    "fontWeight": 600,
    "color": {
      "expr": "muted"
    },
    "anchor": "start",
    "offset": 6,
    "subtitleFont": "Segoe UI, wf_segoe-ui_normal, Arial, sans-serif",
    "subtitleFontSize": 12,
    "subtitleColor": {
      "expr": "muted"
    },
    "subtitlePadding": 4
  },
  "transform": [
    {
      "calculate": "datum['__1__'] === 'composite' ? length(domainOrder) : indexof(domainOrder, datum['__1__'])",
      "as": "domainRank"
    },
    {
      "calculate": "datum['__1__'] === 'composite' ? compositeGap : 0",
      "as": "gapShift"
    },
    {
      "calculate": "indexof(rowOrder, datum['__0__']) < 0 ? length(rowOrder) : indexof(rowOrder, datum['__0__'])",
      "as": "rowPos"
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "rowRank"
        }
      ],
      "sort": [
        {
          "field": "rowPos",
          "order": "ascending"
        },
        {
          "field": "__0__",
          "order": "ascending"
        }
      ]
    },
    {
      "filter": "datum.domainRank >= 0"
    },
    {
      "calculate": "{'healthy': 'Healthy', 'watch': 'Watch', 'act': 'Act'}[datum['__4__']] || datum['__4__']",
      "as": "bandWord"
    },
    {
      "calculate": "isValid(datum['__5__']) && datum['__5__'] !== '' ? datum['__5__'] + '' : upper(substring(datum['__0__'] + '', 0, 2))",
      "as": "chipCode"
    },
    {
      "calculate": "isValid(datum['__6__']) && datum['__6__'] !== '' ? datum['__6__'] + '' : muted",
      "as": "chipColour"
    }
  ],
  "encoding": {
    "x": {
      "field": "__2__",
      "type": "nominal",
      "sort": {
        "field": "domainRank",
        "op": "min"
      },
      "scale": {
        "paddingInner": 0.12,
        "paddingOuter": 0,
        "range": [
          0,
          {
            "expr": "max(0, width - compositeGap)"
          }
        ]
      },
      "axis": {
        "title": null,
        "orient": "top",
