        "domain": false,
        "ticks": false,
        "grid": false,
        "labelAlign": "left",
        "labelFontSize": 13,
        "labelColor": {
          "expr": "ink"
        },
        "labelPadding": 140,
        "labelLimit": 0
      }
    },
    "tooltip": [
