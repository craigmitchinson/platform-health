            }
          },
          "encoding": {
            "x": {
              "field": "barX0",
              "type": "quantitative",
              "scale": null
            },
            "x2": {
              "field": "barX1"
            },
            "y": {
              "field": "barY0",
              "type": "quantitative",
              "scale": null
            },
