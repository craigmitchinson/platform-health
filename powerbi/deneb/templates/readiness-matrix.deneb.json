            }
          },
          "encoding": {
            "x": {
              "field": "countX",
              "type": "quantitative",
              "scale": null
            },
            "text": {
              "field": "countText"
            }
          }
        },
        {
          "mark": {
            "type": "rect",
            "cornerRadius": 2,
            "color": {
