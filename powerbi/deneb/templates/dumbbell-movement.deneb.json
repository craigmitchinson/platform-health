        "field": "__1__",
        "title": "Domain"
      },
      {
        "field": "__3__",
        "title": "Start of period"
      },
      {
        "field": "__4__",
        "title": "Now"
      },
      {
        "field": "moveLabel",
        "title": "Change"
      }
    ],
    "opacity": {
      "condition": {
        "test": "datum.__selected__ === 'off'",
        "value": 0.35
      },
      "value": 1
    }
  },
  "layer": [
