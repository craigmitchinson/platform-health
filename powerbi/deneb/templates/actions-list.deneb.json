      "value": "PRIORITY ACTIONS"
    },
    {
      "name": "compact",
      "expr": "height < 200"
    },
    {
      "name": "rowH",
      "expr": "compact ? 20 : 58"
    },
    {
      "name": "moreH",
      "expr": "compact ? 18 : 22"
    },
    {
      "name": "sideW",
      "expr": "compact ? 170 : 130"
    },
    {
      "name": "fitAll",
      "expr": "max(1, floor(height / rowH))"
    },
    {
      "name": "fitMore",
      "expr": "max(1, floor((height - moreH) / rowH))"
    }
  ],
  "transform": [
    {
      "calculate": "time(toDate(datum['__6__']))",
      "as": "dueTime"
    },
    {
      "calculate": "datum['__7__'] === 'act' ? 0 : 1",
      "as": "sevRank"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "sevRank",
          "order": "ascending"
        },
        {
          "field": "dueTime",
          "order": "ascending"
        },
        {
          "field": "__0__",
          "order": "ascending"
        }
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "total"
        }
      ]
    },
    {
      "calculate": "datum.total <= fitAll ? datum.total : fitMore",
      "as": "shown"
    },
    {
      "calculate": "(datum.rank - 1) * rowH",
      "as": "y0"
    },
    {
      "calculate": "datum.y0 + rowH",
      "as": "y1"
    },
    {
      "calculate": "upper(datum['__1__'] + ' · ' + datum['__2__'])",
      "as": "metaText"
    },
    {
      "calculate": "'Due ' + timeFormat(datum.dueTime, '%-d %b')",
      "as": "dueText"
    },
    {
      "calculate": "datum['__7__'] === 'act' ? 'ACT' : 'WATCH'",
      "as": "sevWord"
    },
    {
      "calculate": "datum['__7__'] === 'act' ? red : amber",
      "as": "sevKey"
    },
    {
      "calculate": "datum['__7__'] === 'act' ? badFill : warnFill",
      "as": "sevFill"
    },
    {
      "calculate": "isValid(datum['__3__']) && datum['__3__'] !== '' ? datum['__3__'] + '' : ''",
      "as": "chipCode"
    },
    {
      "calculate": "isValid(datum['__4__']) && datum['__4__'] !== '' ? datum['__4__'] + '' : muted",
      "as": "chipColour"
    },
    {
      "calculate": "datum.chipCode === '' ? 0 : 30",
      "as": "metaX"
    }
  ],
