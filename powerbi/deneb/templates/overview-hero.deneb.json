        },
        {
          "calculate": "datum.segX + 30",
          "as": "segTextX"
        },
        {
          "calculate": "max(0, datum.segX2 - datum.segX - 40)",
          "as": "segTextLimit"
        },
        {
          "calculate": "[goodFill, warnFill, badFill][datum.segIndex]",
          "as": "segFill"
        },
        {
          "calculate": "[emerald, amber, red][datum.segIndex]",
          "as": "segKey"
        },
        {
          "calculate": "datum.segCount + [' healthy', ' to watch', ' to act'][datum.segIndex]",
          "as": "segLabel"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rect",
            "cornerRadius": 10,
            "strokeWidth": 1.5
          },
          "encoding": {
            "x": {
              "field": "segX",
              "type": "quantitative",
              "scale": null
            },
            "x2": {
              "field": "segX2"
            },
            "y": {
              "field": "segY",
              "type": "quantitative",
              "scale": null
            },
            "y2": {
              "field": "segY2"
            },
            "fill": {
              "field": "segFill",
              "type": "nominal",
              "scale": null
            },
            "stroke": {
              "field": "segKey",
              "type": "nominal",
              "scale": null
            },
            "tooltip": [
              {
                "field": "segLabel",
                "title": "Domains"
              },
              {
                "field": "__5__",
                "title": "Core domains"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "circle",
            "size": 64,
            "opacity": 1
          },
          "encoding": {
            "x": {
              "field": "segDotX",
              "type": "quantitative",
              "scale": null
            },
            "y": {
              "field": "segMid",
              "type": "quantitative",
              "scale": null
            },
            "color": {
              "field": "segKey",
              "type": "nominal",
              "scale": null
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 15,
            "fontWeight": 600,
            "color": {
              "expr": "ink"
            },
            "limit": {
              "expr": "datum.segTextLimit"
            }
          },
          "encoding": {
            "x": {
              "field": "segTextX",
              "type": "quantitative",
              "scale": null
            },
            "y": {
              "field": "segMid",
              "type": "quantitative",
              "scale": null
            },
            "text": {
              "field": "segLabel"
            }
          }
        }
      ]
    }
  ]
}
