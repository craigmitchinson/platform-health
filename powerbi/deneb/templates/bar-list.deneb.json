{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "usermeta": {
    "deneb": {
      "build": "1.7.0.0",
      "metaVersion": 1,
      "provider": "vegaLite",
      "providerVersion": "5.23"
    },
    "information": {
      "name": "Platform Health bar-list",
      "description": "Domain score by team: team scores for one domain, worst first, on a 0 to 100 track coloured by band.",
      "author": "Platform Health contributors",
      "uuid": "875d1a1a-0c9f-5f2f-8cd7-afdcb6f9f555",
      "generated": "2026-09-29T18:14:26.360Z"
    },
    "dataset": [
      {
        "key": "__0__",
        "name": "team",
        "description": "One row per team",
        "type": "text",
        "kind": "column"
      },
      {
        "key": "__1__",
        "name": "lab",
        "description": "Printed beneath the team name",
        "type": "text",
        "kind": "column"
      },
      {
        "key": "__2__",
        "name": "labCode",
        "description": "Optional; the spec falls back when it is not bound.",
        "type": "text",
        "kind": "column"
      },
      {
        "key": "__3__",
        "name": "labColour",
        "description": "Optional; the spec falls back when it is not bound.",
        "type": "text",
        "kind": "column"
      },
      {
        "key": "__4__",
        "name": "score",
        "description": "Domain score out of 100; sorts the rows, lowest first",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__5__",
        "name": "band",
        "description": "`healthy`, `watch` or `act`",
        "type": "text",
        "kind": "measure"
      }
    ],
    "config": "{\n  \"background\": \"transparent\",\n  \"font\": \"Segoe UI, wf_segoe-ui_normal, Arial, sans-serif\",\n  \"padding\": 8,\n  \"view\": {\n    \"stroke\": null\n  },\n  \"title\": {\n    \"font\": \"Fraunces, Cambria, Georgia, serif\",\n    \"fontSize\": 17,\n    \"fontWeight\": 600,\n    \"color\": \"#0F4D43\",\n    \"anchor\": \"start\",\n    \"offset\": 12\n  },\n  \"axis\": {\n    \"domain\": false,\n    \"ticks\": false,\n    \"grid\": true,\n    \"gridColor\": \"#E6E8E2\",\n    \"gridWidth\": 1,\n    \"labelColor\": \"#5F6E69\",\n    \"labelFont\": \"Segoe UI, wf_segoe-ui_normal, Arial, sans-serif\",\n    \"labelFontSize\": 12,\n    \"labelPadding\": 8,\n    \"titleColor\": \"#5F6E69\",\n    \"titleFont\": \"Segoe UI, wf_segoe-ui_normal, Arial, sans-serif\",\n    \"titleFontSize\": 12,\n    \"titleFontWeight\": \"normal\"\n  },\n  \"axisX\": {\n    \"grid\": false\n  },\n  \"legend\": {\n    \"disable\": true\n  },\n  \"range\": {\n    \"category\": [\n      \"#0F4D43\",\n      \"#0B8A6B\",\n      \"#5E8C82\",\n      \"#B9852C\",\n      \"#B6462F\",\n      \"#2A6A5F\",\n      \"#5F6E69\",\n      \"#CFDDD4\",\n      \"#D6D9D2\"\n    ]\n  },\n  \"text\": {\n    \"font\": \"Segoe UI, wf_segoe-ui_normal, Arial, sans-serif\",\n    \"color\": \"#0F4D43\"\n  },\n  \"line\": {\n    \"color\": \"#0F4D43\",\n    \"strokeWidth\": 2.5,\n    \"strokeJoin\": \"round\",\n    \"strokeCap\": \"round\"\n  },\n  \"point\": {\n    \"color\": \"#0B8A6B\",\n    \"filled\": true\n  },\n  \"rule\": {\n    \"color\": \"#D6D9D2\"\n  }\n}",
    "interactivity": {
      "tooltip": true,
      "contextMenu": true,
      "selection": true,
      "selectionMode": "advanced",
      "highlight": false,
      "dataPointLimit": 30000
    }
  },
  "description": "Domain score by team: team scores for one domain, worst first, on a 0 to 100 track coloured by band.",
  "data": {
    "name": "dataset"
  },
  "width": "container",
  "height": "container",
  "background": "transparent",
  "params": [
    {
      "name": "evergreen",
      "expr": "pbiColor(0)"
    },
    {
      "name": "emerald",
      "expr": "pbiColor(1)"
    },
    {
      "name": "sage",
      "value": "#DCE8E0"
    },
    {
      "name": "amber",
      "expr": "pbiColor(3)"
    },
    {
      "name": "red",
      "expr": "pbiColor(4)"
    },
    {
      "name": "ink",
      "expr": "pbiColor(0)"
    },
    {
      "name": "muted",
      "expr": "pbiColor(6)"
    },
    {
      "name": "line",
      "expr": "pbiColor(8)"
    },
    {
      "name": "surface",
      "value": "#FFFFFF"
    },
    {
      "name": "cream",
      "value": "#F7F6F2"
    },
    {
      "name": "goodFill",
      "value": "#DDF0E8"
    },
    {
      "name": "warnFill",
      "value": "#F5EAD6"
    },
    {
      "name": "badFill",
      "value": "#F3E0DA"
    },
    {
      "name": "title",
      "value": "DOMAIN SCORE BY TEAM"
    },
    {
      "name": "labelWidth",
      "value": 220
    },
    {
      "name": "valueWidth",
      "value": 110
    },
    {
      "name": "valueGap",
      "value": 12
    },
    {
      "name": "tall",
      "expr": "height / max(1, length(data('dataset'))) >= 34"
    },
    {
      "name": "unitLabel",
      "value": ""
    }
  ],
  "title": {
    "text": {
      "expr": "unitLabel !== '' && title === 'DOMAIN SCORE BY TEAM' ? upper(unitLabel) + ' BY DOMAIN' : title"
    },
    "font": "JetBrains Mono, Consolas, monospace",
    "fontSize": 12.5,
    "fontWeight": 600,
    "color": {
      "expr": "muted"
    },
    "anchor": "start",
    "offset": 6
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "__4__",
          "as": "scoreMax"
        }
      ]
    },
    {
      "calculate": "unitLabel === '' ? 100 : max(1, datum.scoreMax)",
      "as": "scaleTop"
    },
    {
      "calculate": "labelWidth",
      "as": "trackStart"
    },
    {
      "calculate": "max(labelWidth + 40, width - valueWidth - valueGap)",
      "as": "trackEnd"
    },
    {
      "calculate": "datum.trackStart + (datum.trackEnd - datum.trackStart) * clamp(datum['__4__'], 0, datum.scaleTop) / datum.scaleTop",
      "as": "barEnd"
    },
    {
      "calculate": "unitLabel !== '' ? evergreen : datum['__5__'] === 'healthy' ? emerald : datum['__5__'] === 'watch' ? amber : red",
      "as": "bandColour"
    },
    {
      "calculate": "unitLabel !== '' ? '' : datum['__5__'] === 'healthy' ? 'Healthy' : datum['__5__'] === 'watch' ? 'Watch' : 'Act'",
      "as": "bandLabel"
    },
    {
      "calculate": "unitLabel !== '' ? datum['__4__'] + ' ' + unitLabel : datum['__4__'] + ' · ' + datum.bandLabel",
      "as": "valueLabel"
    },
    {
      "calculate": "isValid(datum['__1__']) ? datum['__1__'] + '' : ''",
      "as": "labText"
    },
    {
      "calculate": "tall ? datum.labText : ''",
      "as": "labLine"
    },
    {
      "calculate": "isValid(datum['__2__']) && datum['__2__'] !== '' ? datum['__2__'] + '' : upper(substring(datum.labText, 0, 2))",
      "as": "chipCode"
    },
    {
      "calculate": "isValid(datum['__3__']) && datum['__3__'] !== '' ? datum['__3__'] + '' : muted",
      "as": "chipColour"
    },
    {
      "calculate": "datum.chipCode === '' ? 0 : 30",
      "as": "textX"
    },
    {
      "calculate": "unitLabel !== '' ? -datum['__4__'] : datum['__4__']",
      "as": "sortScore"
    },
    {
      "joinaggregate": [
        {
          "op": "mean",
          "field": "__4__",
          "as": "scoreMean"
        }
      ]
    },
    {
      "calculate": "round(datum.scoreMean)",
      "as": "scopeMean"
    },
    {
      "calculate": "datum.trackStart + (datum.trackEnd - datum.trackStart) * clamp(datum.scopeMean, 0, 100) / 100",
      "as": "meanX"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "barOrder"
        }
      ],
      "sort": [
        {
          "field": "sortScore",
          "order": "ascending"
        },
        {
          "field": "__0__",
          "order": "ascending"
        }
      ]
    }
  ],
  "encoding": {
    "y": {
      "field": "__0__",
      "type": "nominal",
      "sort": {
        "field": "barOrder",
        "op": "min",
        "order": "ascending"
      },
      "scale": {
        "paddingInner": 0.2,
        "paddingOuter": 0.1,
        "range": [
          22,
          {
            "expr": "max(22, height)"
          }
        ]
      },
      "axis": null
    },
    "tooltip": [
      {
        "field": "__0__",
        "title": "Team"
      },
      {
        "field": "__1__",
        "title": "Lab"
      },
      {
        "field": "__4__",
        "title": "Score"
      },
      {
        "field": "bandLabel",
        "title": "Band"
      }
    ],
    "opacity": {
      "condition": {
        "test": "datum.__selected__ === 'off'",
        "value": 0.35
      },
      "value": 1
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "unitLabel === ''"
        },
        {
          "aggregate": [
            {
              "op": "min",
              "field": "trackStart",
              "as": "trackStart"
            },
            {
              "op": "min",
              "field": "trackEnd",
              "as": "trackEnd"
            }
          ]
        },
        {
          "fold": [
            "60",
            "80"
          ],
          "as": [
            "refKey",
            "refValue"
          ]
        },
        {
          "calculate": "datum.trackStart + (datum.trackEnd - datum.trackStart) * toNumber(datum.refKey) / 100",
          "as": "refX"
        }
      ],
      "mark": {
        "type": "rule",
        "y": 18,
        "y2": {
          "expr": "height"
        },
        "color": {
          "expr": "line"
        },
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "refX",
          "type": "quantitative",
          "scale": null
        },
        "y": null,
        "tooltip": null
      }
    },
    {
      "mark": {
        "type": "bar",
        "height": 12,
        "cornerRadius": 6,
        "color": {
          "expr": "sage"
        }
      },
      "encoding": {
        "x": {
          "field": "trackStart",
          "type": "quantitative",
          "scale": null
        },
        "x2": {
          "field": "trackEnd"
        }
      }
    },
    {
      "params": [
        {
          "name": "__select__",
          "select": {
            "type": "point",
            "fields": [
              "__0__"
            ],
            "on": "click",
            "clear": "dblclick"
          }
        }
      ],
      "mark": {
        "type": "bar",
        "height": 12,
        "cornerRadius": 6
      },
      "encoding": {
        "x": {
          "field": "trackStart",
          "type": "quantitative",
          "scale": null
        },
        "x2": {
          "field": "barEnd"
        },
        "color": {
          "field": "bandColour",
          "type": "nominal",
          "scale": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "x": {
          "expr": "datum.textX"
        },
        "align": "left",
        "baseline": {
          "expr": "datum.labLine === '' ? 'middle' : 'bottom'"
        },
        "dy": {
          "expr": "datum.labLine === '' ? 0 : -1"
        },
        "fontSize": 13,
        "color": {
          "expr": "ink"
        }
      },
      "encoding": {
        "text": {
          "field": "__0__"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "x": {
          "expr": "datum.textX"
        },
        "align": "left",
        "baseline": "top",
        "dy": 2,
        "fontSize": 11,
        "color": {
          "expr": "muted"
        }
      },
      "encoding": {
        "text": {
          "field": "labLine"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.chipCode !== ''"
        }
      ],
      "mark": {
        "type": "rect",
        "cornerRadius": 4,
        "x": 0,
        "x2": 22,
        "y": {
          "expr": "scale('y', datum['__0__']) + bandwidth('y') / 2 - 9"
        },
        "y2": {
          "expr": "scale('y', datum['__0__']) + bandwidth('y') / 2 + 9"
        }
      },
      "encoding": {
        "y": null,
        "color": {
          "field": "chipColour",
          "type": "nominal",
          "scale": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.chipCode !== ''"
        }
      ],
      "mark": {
        "type": "text",
        "x": 11,
        "align": "center",
        "baseline": "middle",
        "font": "JetBrains Mono, Consolas, monospace",
        "fontSize": 10,
        "fontWeight": 700,
        "color": {
          "expr": "surface"
        }
      },
      "encoding": {
        "text": {
          "field": "chipCode"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "x": "width",
        "align": "right",
        "baseline": "middle",
        "font": "JetBrains Mono, Consolas, monospace",
        "fontSize": 13,
        "fontWeight": 600,
        "color": {
          "expr": "ink"
        }
      },
      "encoding": {
        "text": {
          "field": "valueLabel"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "unitLabel === ''"
        },
        {
          "aggregate": [
            {
              "op": "min",
              "field": "meanX",
              "as": "meanX"
            },
            {
              "op": "min",
              "field": "scopeMean",
              "as": "scopeMean"
            }
          ]
        },
        {
          "calculate": "'Scope mean ' + datum.scopeMean",
          "as": "meanLabel"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rule",
            "y": 18,
            "y2": {
              "expr": "height"
            },
            "color": {
              "expr": "ink"
            },
            "strokeWidth": 1.5,
            "strokeDash": [
              4,
              3
            ]
          },
          "encoding": {
            "x": {
              "field": "meanX",
              "type": "quantitative",
              "scale": null
            },
            "y": null,
            "tooltip": null
          }
        },
        {
          "mark": {
            "type": "text",
            "y": 8,
            "align": "center",
            "baseline": "middle",
            "font": "JetBrains Mono, Consolas, monospace",
            "fontSize": 11,
            "fontWeight": 600,
            "color": {
              "expr": "ink"
            }
          },
          "encoding": {
            "x": {
              "field": "meanX",
              "type": "quantitative",
              "scale": null
            },
            "y": null,
            "text": {
              "field": "meanLabel"
            },
            "tooltip": [
              {
                "field": "scopeMean",
                "title": "Scope mean"
              }
            ]
          }
        }
      ]
    }
  ]
}
