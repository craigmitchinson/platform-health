            "y": null,
            "text": {
              "field": "label"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "word": "today"
          }
        ]
      },
      "layer": [
        {
          "transform": [
            {
              "calculate": "refreshTime",
              "as": "todayTime"
            }
          ],
          "mark": {
