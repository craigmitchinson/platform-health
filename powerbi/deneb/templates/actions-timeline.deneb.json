              }
            }
          }
        }
      ]
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "actCount",
              "as": "actCount"
            },
            {
              "op": "min",
              "field": "rowH",
              "as": "rowH"
            },
            {
              "op": "min",
              "field": "total",
              "as": "total"
            }
          ]
        },
        {
          "calculate": "[topSpace + datum.actCount * datum.rowH / 2, topSpace + datum.actCount * datum.rowH + laneGap + (datum.total - datum.actCount) * datum.rowH / 2]",
          "as": "laneMid"
        },
        {
          "calculate": "['ACT', 'WATCH']",
          "as": "laneWord"
        },
        {
          "calculate": "[datum.actCount + ' due', (datum.total - datum.actCount) + ' due']",
          "as": "laneCount"
        },
        {
          "flatten": [
            "laneMid",
            "laneWord",
            "laneCount"
          ],
          "as": [
            "laneY",
            "laneName",
            "laneNote"
          ]
