{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Metric by team for one domain: teams worst domain score first, a column per scored metric in domain order, each cell the team's formatted value tinted and striped by its metric band, so the value and the tooltip's band word carry the state as well as colour.",
  "data": { "name": "dataset" },
  "width": "container",
  "height": "container",
  "background": "transparent",
  "params": [
    { "name": "emerald", "expr": "pbiColor(1)" },
    { "name": "sage", "value": "#DCE8E0" },
    { "name": "amber", "expr": "pbiColor(3)" },
    { "name": "red", "expr": "pbiColor(4)" },
    { "name": "ink", "expr": "pbiColor(0)" },
    { "name": "muted", "expr": "pbiColor(6)" },
    { "name": "surface", "value": "#FFFFFF" },
    { "name": "goodFill", "value": "#DDF0E8" },
    { "name": "warnFill", "value": "#F5EAD6" },
    { "name": "badFill", "value": "#F3E0DA" },
    { "name": "title", "value": "BY TEAM AND METRIC" }
  ],
  "title": {
    "text": { "expr": "title" },
    "font": "JetBrains Mono, Consolas, monospace",
    "fontSize": 12.5,
    "fontWeight": 600,
    "color": { "expr": "muted" },
    "anchor": "start",
    "offset": 6
  },
  "transform": [
    { "filter": "isValid(datum.team) && isValid(datum.short)" },
    { "calculate": "isValid(datum.teamScore) ? datum.teamScore : 999", "as": "rowScore" },
    { "window": [{ "op": "dense_rank", "as": "rowRank" }], "sort": [{ "field": "rowScore", "order": "ascending" }, { "field": "team", "order": "ascending" }] },
    { "calculate": "isValid(datum.formatted) ? datum.formatted + '' : ''", "as": "cellText" },
    { "calculate": "{'healthy': 'Healthy', 'watch': 'Watch', 'act': 'Act'}[datum.band] || 'Context'", "as": "bandWord" },
    {
      "calculate": "isValid(datum.labCode) && datum.labCode !== '' ? datum.labCode + '' : upper(substring(datum.team + '', 0, 2))",
      "as": "chipCode"
    },
    { "calculate": "isValid(datum.labColour) && datum.labColour !== '' ? datum.labColour + '' : muted", "as": "chipColour" }
  ],
  "encoding": {
    "x": {
      "field": "short",
      "type": "nominal",
      "sort": { "field": "metricOrder", "op": "min" },
      "scale": { "paddingInner": 0.08, "paddingOuter": 0 },
      "axis": {
        "title": null,
        "orient": "top",
        "domain": false,
        "ticks": false,
        "grid": false,
        "labelAngle": 0,
        "labelAlign": "center",
        "labelBaseline": "bottom",
        "labelFont": "Fraunces, Cambria, Georgia, serif",
        "labelFontSize": 11,
        "labelFontWeight": 600,
        "labelColor": { "expr": "ink" },
        "labelExpr": "indexof(datum.label, ' ') > 0 ? [substring(datum.label, 0, indexof(datum.label, ' ')), substring(datum.label, indexof(datum.label, ' ') + 1)] : ['', datum.label]",
        "labelLineHeight": 13,
        "labelPadding": 18,
        "labelLimit": 0
      }
    },
    "y": {
      "field": "team",
      "type": "nominal",
      "sort": { "field": "rowRank", "op": "min", "order": "ascending" },
      "scale": { "paddingInner": 0.14, "paddingOuter": 0 },
      "axis": {
        "title": null,
        "orient": "left",
        "domain": false,
        "ticks": false,
        "grid": false,
        "labelAlign": "left",
        "labelFontSize": 12,
        "labelColor": { "expr": "ink" },
        "labelPadding": 132,
        "labelLimit": 126
      }
    },
    "tooltip": [
      { "field": "team", "title": "Team" },
      { "field": "short", "title": "Metric" },
      { "field": "cellText", "title": "Value" },
      { "field": "bandWord", "title": "Band" }
    ],
    "opacity": { "condition": { "test": "datum.__selected__ === 'off'", "value": 0.35 }, "value": 1 }
  },
  "layer": [
    {
      "transform": [{ "aggregate": [{ "op": "min", "field": "rowRank", "as": "rowRank" }], "groupby": ["team", "chipCode", "chipColour"] }],
      "layer": [
        {
          "mark": {
            "type": "rect",
            "cornerRadius": 4,
            "x": -160,
            "x2": -138,
            "y": { "expr": "scale('y', datum.team) + bandwidth('y') / 2 - 8" },
            "y2": { "expr": "scale('y', datum.team) + bandwidth('y') / 2 + 8" }
          },
          "encoding": {
            "x": null,
            "y": null,
            "color": { "field": "chipColour", "type": "nominal", "scale": null },
            "tooltip": null,
            "opacity": null
          }
        },
        {
          "mark": {
            "type": "text",
            "x": -149,
            "y": { "expr": "scale('y', datum.team) + bandwidth('y') / 2" },
            "align": "center",
            "baseline": "middle",
            "font": "JetBrains Mono, Consolas, monospace",
            "fontSize": 10,
            "fontWeight": 700,
            "color": { "expr": "surface" }
          },
          "encoding": { "x": null, "y": null, "text": { "field": "chipCode" }, "tooltip": null, "opacity": null }
        }
      ]
    },
    {
      "params": [
        { "name": "__select__", "select": { "type": "point", "fields": ["team"], "on": "click", "clear": "dblclick" } }
      ],
      "mark": { "type": "rect", "cornerRadius": 4 },
      "encoding": {
        "color": {
          "condition": [
            { "test": "datum.band === 'healthy'", "value": { "expr": "goodFill" } },
            { "test": "datum.band === 'watch'", "value": { "expr": "warnFill" } },
            { "test": "datum.band === 'act'", "value": { "expr": "badFill" } }
          ],
          "value": { "expr": "sage" }
        }
      }
    },
    {
      "mark": {
        "type": "rect",
        "width": 3,
        "xOffset": { "expr": "1.5 - bandwidth('x') / 2" },
        "cornerRadiusTopLeft": 3,
        "cornerRadiusBottomLeft": 3
      },
      "encoding": {
        "color": {
          "condition": [
            { "test": "datum.band === 'healthy'", "value": { "expr": "emerald" } },
            { "test": "datum.band === 'watch'", "value": { "expr": "amber" } },
            { "test": "datum.band === 'act'", "value": { "expr": "red" } }
          ],
          "value": { "expr": "muted" }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 11.5,
        "fontWeight": 600,
        "color": { "expr": "ink" },
        "xOffset": 1.5,
        "limit": { "expr": "bandwidth('x') - 8" }
      },
      "encoding": { "text": { "field": "cellText" } }
    }
  ]
}
