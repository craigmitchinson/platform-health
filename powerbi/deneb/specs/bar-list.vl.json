{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Domain score by team: team scores for one domain, worst first, on a 0 to 100 track coloured by band.",
  "data": { "name": "dataset" },
  "width": "container",
  "height": "container",
  "background": "transparent",
  "params": [
    { "name": "evergreen", "expr": "pbiColor(0)" },
    { "name": "emerald", "expr": "pbiColor(1)" },
    { "name": "sage", "value": "#DCE8E0" },
    { "name": "amber", "expr": "pbiColor(3)" },
    { "name": "red", "expr": "pbiColor(4)" },
    { "name": "ink", "expr": "pbiColor(0)" },
    { "name": "muted", "expr": "pbiColor(6)" },
    { "name": "line", "expr": "pbiColor(8)" },
    { "name": "surface", "value": "#FFFFFF" },
    { "name": "cream", "value": "#F7F6F2" },
    { "name": "goodFill", "value": "#DDF0E8" },
    { "name": "warnFill", "value": "#F5EAD6" },
    { "name": "badFill", "value": "#F3E0DA" },
    { "name": "title", "value": "DOMAIN SCORE BY TEAM" },
    { "name": "labelWidth", "value": 220 },
    { "name": "valueWidth", "value": 110 },
    { "name": "valueGap", "value": 12 },
    { "name": "tall", "expr": "height / max(1, length(data('dataset'))) >= 34" },
    { "name": "unitLabel", "value": "" }
  ],
  "title": {
    "text": { "expr": "unitLabel !== '' && title === 'DOMAIN SCORE BY TEAM' ? upper(unitLabel) + ' BY DOMAIN' : title" },
    "font": "JetBrains Mono, Consolas, monospace",
    "fontSize": 12.5,
    "fontWeight": 600,
    "color": { "expr": "muted" },
    "anchor": "start",
    "offset": 6
  },
  "transform": [
    { "joinaggregate": [{ "op": "max", "field": "score", "as": "scoreMax" }] },
    { "calculate": "unitLabel === '' ? 100 : max(1, datum.scoreMax)", "as": "scaleTop" },
    { "calculate": "labelWidth", "as": "trackStart" },
    { "calculate": "max(labelWidth + 40, width - valueWidth - valueGap)", "as": "trackEnd" },
    {
      "calculate": "datum.trackStart + (datum.trackEnd - datum.trackStart) * clamp(datum.score, 0, datum.scaleTop) / datum.scaleTop",
      "as": "barEnd"
    },
    {
      "calculate": "unitLabel !== '' ? evergreen : datum.band === 'healthy' ? emerald : datum.band === 'watch' ? amber : red",
      "as": "bandColour"
    },
    {
      "calculate": "unitLabel !== '' ? '' : datum.band === 'healthy' ? 'Healthy' : datum.band === 'watch' ? 'Watch' : 'Act'",
      "as": "bandLabel"
    },
    { "calculate": "unitLabel !== '' ? datum.score + ' ' + unitLabel : datum.score + ' · ' + datum.bandLabel", "as": "valueLabel" },
    { "calculate": "isValid(datum.lab) ? datum.lab + '' : ''", "as": "labText" },
    { "calculate": "tall ? datum.labText : ''", "as": "labLine" },
    {
      "calculate": "isValid(datum.labCode) && datum.labCode !== '' ? datum.labCode + '' : upper(substring(datum.labText, 0, 2))",
      "as": "chipCode"
    },
    { "calculate": "isValid(datum.labColour) && datum.labColour !== '' ? datum.labColour + '' : muted", "as": "chipColour" },
    { "calculate": "datum.chipCode === '' ? 0 : 30", "as": "textX" },
    { "calculate": "unitLabel !== '' ? -datum.score : datum.score", "as": "sortScore" },
    { "joinaggregate": [{ "op": "mean", "field": "score", "as": "scoreMean" }] },
    { "calculate": "round(datum.scoreMean)", "as": "scopeMean" },
    {
      "calculate": "datum.trackStart + (datum.trackEnd - datum.trackStart) * clamp(datum.scopeMean, 0, 100) / 100",
      "as": "meanX"
    },
    {
      "window": [{ "op": "row_number", "as": "barOrder" }],
      "sort": [{ "field": "sortScore", "order": "ascending" }, { "field": "team", "order": "ascending" }]
    }
  ],
  "encoding": {
    "y": {
      "field": "team",
      "type": "nominal",
      "sort": { "field": "barOrder", "op": "min", "order": "ascending" },
      "scale": { "paddingInner": 0.2, "paddingOuter": 0.1, "range": [22, { "expr": "max(22, height)" }] },
      "axis": null
    },
    "tooltip": [
      { "field": "team", "title": "Team" },
      { "field": "lab", "title": "Lab" },
      { "field": "score", "title": "Score" },
      { "field": "bandLabel", "title": "Band" }
    ],
    "opacity": { "condition": { "test": "datum.__selected__ === 'off'", "value": 0.35 }, "value": 1 }
  },
  "layer": [
    {
      "transform": [
        { "filter": "unitLabel === ''" },
        { "aggregate": [{ "op": "min", "field": "trackStart", "as": "trackStart" }, { "op": "min", "field": "trackEnd", "as": "trackEnd" }] },
        { "fold": ["60", "80"], "as": ["refKey", "refValue"] },
        {
          "calculate": "datum.trackStart + (datum.trackEnd - datum.trackStart) * toNumber(datum.refKey) / 100",
          "as": "refX"
        }
      ],
      "mark": { "type": "rule", "y": 18, "y2": { "expr": "height" }, "color": { "expr": "line" }, "strokeWidth": 1 },
      "encoding": {
        "x": { "field": "refX", "type": "quantitative", "scale": null },
        "y": null,
        "tooltip": null
      }
    },
    {
      "mark": { "type": "bar", "height": 12, "cornerRadius": 6, "color": { "expr": "sage" } },
      "encoding": {
        "x": { "field": "trackStart", "type": "quantitative", "scale": null },
        "x2": { "field": "trackEnd" }
      }
    },
    {
      "params": [
        { "name": "__select__", "select": { "type": "point", "fields": ["team"], "on": "click", "clear": "dblclick" } }
      ],
      "mark": { "type": "bar", "height": 12, "cornerRadius": 6 },
      "encoding": {
        "x": { "field": "trackStart", "type": "quantitative", "scale": null },
        "x2": { "field": "barEnd" },
        "color": { "field": "bandColour", "type": "nominal", "scale": null }
      }
    },
    {
      "mark": {
        "type": "text",
        "x": { "expr": "datum.textX" },
        "align": "left",
        "baseline": { "expr": "datum.labLine === '' ? 'middle' : 'bottom'" },
        "dy": { "expr": "datum.labLine === '' ? 0 : -1" },
        "fontSize": 13,
        "color": { "expr": "ink" }
      },
      "encoding": { "text": { "field": "team" } }
    },
    {
      "mark": {
        "type": "text",
        "x": { "expr": "datum.textX" },
        "align": "left",
        "baseline": "top",
        "dy": 2,
        "fontSize": 11,
        "color": { "expr": "muted" }
      },
      "encoding": { "text": { "field": "labLine" } }
    },
    {
      "transform": [{ "filter": "datum.chipCode !== ''" }],
      "mark": {
        "type": "rect",
        "cornerRadius": 4,
        "x": 0,
        "x2": 22,
        "y": { "expr": "scale('y', datum.team) + bandwidth('y') / 2 - 9" },
        "y2": { "expr": "scale('y', datum.team) + bandwidth('y') / 2 + 9" }
      },
      "encoding": { "y": null, "color": { "field": "chipColour", "type": "nominal", "scale": null } }
    },
    {
      "transform": [{ "filter": "datum.chipCode !== ''" }],
      "mark": {
        "type": "text",
        "x": 11,
        "align": "center",
        "baseline": "middle",
        "font": "JetBrains Mono, Consolas, monospace",
        "fontSize": 10,
        "fontWeight": 700,
        "color": { "expr": "surface" }
      },
      "encoding": { "text": { "field": "chipCode" } }
    },
    {
      "mark": {
        "type": "text",
        "x": "width",
        "align": "right",
        "baseline": "middle",
        "font": "JetBrains Mono, Consolas, monospace",
        "fontSize": 13,
        "fontWeight": 600,
        "color": { "expr": "ink" }
      },
      "encoding": { "text": { "field": "valueLabel" } }
    },
    {
      "transform": [
        { "filter": "unitLabel === ''" },
        { "aggregate": [{ "op": "min", "field": "meanX", "as": "meanX" }, { "op": "min", "field": "scopeMean", "as": "scopeMean" }] },
        { "calculate": "'Scope mean ' + datum.scopeMean", "as": "meanLabel" }
      ],
      "layer": [
        {
          "mark": {
            "type": "rule",
            "y": 18,
            "y2": { "expr": "height" },
            "color": { "expr": "ink" },
            "strokeWidth": 1.5,
            "strokeDash": [4, 3]
          },
          "encoding": {
            "x": { "field": "meanX", "type": "quantitative", "scale": null },
            "y": null,
            "tooltip": null
          }
        },
        {
          "mark": {
            "type": "text",
            "y": 8,
            "align": "center",
            "baseline": "middle",
            "font": "JetBrains Mono, Consolas, monospace",
            "fontSize": 11,
            "fontWeight": 600,
            "color": { "expr": "ink" }
          },
          "encoding": {
            "x": { "field": "meanX", "type": "quantitative", "scale": null },
            "y": null,
            "text": { "field": "meanLabel" },
            "tooltip": [{ "field": "scopeMean", "title": "Scope mean" }]
          }
        }
      ]
    }
  ]
}
