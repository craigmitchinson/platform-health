{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Six-quarter trend by lab and domain: a grid of small sparklines, one row per lab and one column per core domain, each cell tinted by this quarter's band with the current score and band word.",
  "data": { "name": "dataset" },
  "width": "container",
  "height": "container",
  "background": "transparent",
  "params": [
    { "name": "evergreen", "expr": "pbiColor(0)" },
    { "name": "emerald", "expr": "pbiColor(1)" },
    { "name": "sage", "value": "#DCE8E0" },
    { "name": "amber", "expr": "pbiColor(3)" },
    { "name": "red", "expr": "pbiColor(4)" },
    { "name": "ink", "expr": "pbiColor(0)" },
    { "name": "muted", "expr": "pbiColor(6)" },
    { "name": "line", "expr": "pbiColor(8)" },
    { "name": "surface", "value": "#FFFFFF" },
    { "name": "cream", "value": "#F7F6F2" },
    { "name": "goodFill", "value": "#DDF0E8" },
    { "name": "warnFill", "value": "#F5EAD6" },
    { "name": "badFill", "value": "#F3E0DA" },
    { "name": "title", "value": "SIX-QUARTER TREND BY LAB AND DOMAIN" },
    {
      "name": "domainOrder",
      "value": ["stability", "incidents", "problems", "maturity", "architecture", "risk", "security", "resilience", "change", "estate", "governance", "delivery", "people"]
    },
    { "name": "labOrder", "value": ["24*7 Services", "Colleague Tooling", "Agentic Operations", "Data & Insights"] },
    { "name": "labelWidth", "value": 170 },
    { "name": "headerHeight", "value": 40 },
    { "name": "cellGap", "value": 6 }
  ],
  "title": {
    "text": { "expr": "title" },
    "subtitle": "Cells shaded by this quarter's band: Healthy 80 and above · Watch 60 to 79 · Act below 60",
    "font": "JetBrains Mono, Consolas, monospace",
    "fontSize": 12.5,
    "fontWeight": 600,
    "color": { "expr": "muted" },
    "anchor": "start",
    "offset": 6,
    "subtitleFont": "Segoe UI, wf_segoe-ui_normal, Arial, sans-serif",
    "subtitleFontSize": 12,
    "subtitleColor": { "expr": "muted" },
    "subtitlePadding": 4
  },
  "transform": [
    { "calculate": "indexof(domainOrder, datum.domainId)", "as": "col" },
    { "filter": "datum.col >= 0" },
    { "calculate": "indexof(labOrder, datum.lab) < 0 ? length(labOrder) : indexof(labOrder, datum.lab)", "as": "labIndex" },
    {
      "window": [{ "op": "dense_rank", "as": "labRank" }],
      "sort": [{ "field": "labIndex", "order": "ascending" }, { "field": "lab", "order": "ascending" }]
    },
    {
      "joinaggregate": [
        { "op": "max", "field": "labRank", "as": "labCount" },
        { "op": "min", "field": "score", "as": "allMin" },
        { "op": "max", "field": "score", "as": "allMax" }
      ]
    },
    {
      "window": [
        { "op": "first_value", "field": "score", "as": "firstScore" },
        { "op": "last_value", "field": "score", "as": "lastScore" },
        { "op": "max", "field": "quarter", "as": "lastQuarter" },
        { "op": "min", "field": "quarter", "as": "firstQuarter" }
      ],
      "sort": [{ "field": "quarter", "order": "ascending" }],
      "groupby": ["lab", "domainId"],
      "frame": [null, null]
    },
    { "calculate": "max(1, (width - labelWidth) / length(domainOrder))", "as": "cellW" },
    { "calculate": "max(1, (height - headerHeight) / datum.labCount)", "as": "cellH" },
    { "calculate": "labelWidth + datum.col * datum.cellW + cellGap / 2", "as": "x0" },
    { "calculate": "datum.x0 + datum.cellW - cellGap", "as": "x1" },
    { "calculate": "headerHeight + (datum.labRank - 1) * datum.cellH + cellGap / 2", "as": "y0" },
    { "calculate": "datum.y0 + datum.cellH - cellGap", "as": "y1" },
    { "calculate": "min(datum.allMin, 60) - 4", "as": "sparkLow" },
    { "calculate": "min(100, max(datum.allMax, 88) + 2)", "as": "sparkHigh" },
    { "calculate": "datum.y0 + 28", "as": "sparkTop" },
    { "calculate": "datum.y1 - 7", "as": "sparkBase" },
    {
      "calculate": "datum.x0 + 10 + (datum.x1 - datum.x0 - 22) * (datum.quarter - datum.firstQuarter) / max(1, datum.lastQuarter - datum.firstQuarter)",
      "as": "sx"
    },
    {
      "calculate": "datum.sparkBase - (datum.sparkBase - datum.sparkTop) * (clamp(datum.score, datum.sparkLow, datum.sparkHigh) - datum.sparkLow) / (datum.sparkHigh - datum.sparkLow)",
      "as": "sy"
    },
    {
      "calculate": "datum.band === 'healthy' ? emerald : datum.band === 'watch' ? amber : datum.band === 'act' ? red : muted",
      "as": "bandKey"
    },
    {
      "calculate": "datum.band === 'healthy' ? goodFill : datum.band === 'watch' ? warnFill : datum.band === 'act' ? badFill : sage",
      "as": "bandFill"
    },
    {
      "calculate": "{'healthy': 'HEALTHY', 'watch': 'WATCH', 'act': 'ACT'}[datum.band] || upper(datum.band)",
      "as": "bandWord"
    },
    { "calculate": "datum.x0 + 10", "as": "scoreX" },
    { "calculate": "datum.y0 + 8", "as": "scoreY" },
    { "calculate": "datum.x1 - 8", "as": "wordX" },
    {
      "calculate": "isValid(datum.labCode) && datum.labCode !== '' ? datum.labCode + '' : upper(substring(datum.lab + '', 0, 2))",
      "as": "chipCode"
    },
    { "calculate": "isValid(datum.labColour) && datum.labColour !== '' ? datum.labColour + '' : muted", "as": "chipColour" }
  ],
  "encoding": {
    "opacity": { "condition": { "test": "datum.__selected__ === 'off'", "value": 0.35 }, "value": 1 }
  },
  "layer": [
    {
      "transform": [{ "filter": "datum.quarter === datum.lastQuarter" }],
      "params": [
        { "name": "__select__", "select": { "type": "point", "fields": ["lab", "domainId"], "on": "click", "clear": "dblclick" } }
      ],
      "mark": { "type": "rect", "cornerRadius": 6 },
      "encoding": {
        "x": { "field": "x0", "type": "quantitative", "scale": null },
        "x2": { "field": "x1" },
        "y": { "field": "y0", "type": "quantitative", "scale": null },
        "y2": { "field": "y1" },
        "fill": { "field": "bandFill", "type": "nominal", "scale": null },
        "tooltip": [
          { "field": "lab", "title": "Lab" },
          { "field": "domain", "title": "Domain" },
          { "field": "lastScore", "title": "Score this quarter" },
          { "field": "firstScore", "title": "Score six quarters ago" },
          { "field": "bandWord", "title": "Band" }
        ]
      }
    },
    {
      "mark": { "type": "area", "color": { "expr": "emerald" }, "fillOpacity": 0.3 },
      "encoding": {
        "x": { "field": "sx", "type": "quantitative", "scale": null },
        "y": { "field": "sy", "type": "quantitative", "scale": null },
        "y2": { "field": "sparkBase" },
        "detail": [{ "field": "lab" }, { "field": "domainId" }]
      }
    },
    {
      "mark": { "type": "line", "strokeWidth": 1.5, "color": { "expr": "evergreen" } },
      "encoding": {
        "x": { "field": "sx", "type": "quantitative", "scale": null },
        "y": { "field": "sy", "type": "quantitative", "scale": null },
        "detail": [{ "field": "lab" }, { "field": "domainId" }],
        "order": { "field": "quarter", "type": "quantitative" }
      }
    },
    {
      "transform": [{ "filter": "datum.quarter === datum.lastQuarter" }],
      "layer": [
        {
          "mark": { "type": "circle", "size": 40, "stroke": { "expr": "surface" }, "strokeWidth": 1.5 },
          "encoding": {
            "x": { "field": "sx", "type": "quantitative", "scale": null },
            "y": { "field": "sy", "type": "quantitative", "scale": null },
            "color": { "field": "bandKey", "type": "nominal", "scale": null }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "font": "Fraunces, Cambria, Georgia, serif",
            "fontSize": 16,
            "fontWeight": 600,
            "color": { "expr": "ink" }
          },
          "encoding": {
            "x": { "field": "scoreX", "type": "quantitative", "scale": null },
            "y": { "field": "scoreY", "type": "quantitative", "scale": null },
            "text": { "field": "lastScore" }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "top",
            "dy": 3,
            "font": "JetBrains Mono, Consolas, monospace",
            "fontSize": 10,
            "fontWeight": 600,
            "color": { "expr": "ink" }
          },
          "encoding": {
            "x": { "field": "wordX", "type": "quantitative", "scale": null },
            "y": { "field": "scoreY", "type": "quantitative", "scale": null },
            "text": { "field": "bandWord" }
          }
        }
      ]
    },
    {
      "transform": [
        { "filter": "datum.quarter === datum.lastQuarter && datum.labRank === 1" },
        { "calculate": "(datum.x0 + datum.x1) / 2", "as": "headX" },
        { "calculate": "headerHeight - 20", "as": "headY" },
        {
          "calculate": "indexof(datum.domain, ' ') > 0 ? [slice(datum.domain, 0, indexof(datum.domain, ' ')), slice(datum.domain, indexof(datum.domain, ' ') + 1)] : ['', datum.domain]",
          "as": "headText"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "lineHeight": 14,
        "font": "Fraunces, Cambria, Georgia, serif",
        "fontSize": 12,
        "fontWeight": 600,
        "color": { "expr": "ink" }
      },
      "encoding": {
        "x": { "field": "headX", "type": "quantitative", "scale": null },
        "y": { "field": "headY", "type": "quantitative", "scale": null },
        "text": { "field": "headText" },
        "opacity": null
      }
    },
    {
      "transform": [
        { "filter": "datum.quarter === datum.lastQuarter && datum.col === 0" },
        { "calculate": "(datum.y0 + datum.y1) / 2", "as": "labY" }
      ],
      "layer": [
        {
          "mark": {
            "type": "rect",
            "cornerRadius": 4,
            "x": 0,
            "x2": 22,
            "y": { "expr": "(datum.y0 + datum.y1) / 2 - 9" },
            "y2": { "expr": "(datum.y0 + datum.y1) / 2 + 9" }
          },
          "encoding": { "x": null, "y": null, "color": { "field": "chipColour", "type": "nominal", "scale": null }, "opacity": null }
        },
        {
          "mark": {
            "type": "text",
            "x": 11,
            "y": { "expr": "(datum.y0 + datum.y1) / 2" },
            "align": "center",
            "baseline": "middle",
            "font": "JetBrains Mono, Consolas, monospace",
            "fontSize": 10,
            "fontWeight": 700,
            "color": { "expr": "surface" }
          },
          "encoding": { "x": null, "y": null, "text": { "field": "chipCode" }, "opacity": null }
        },
        {
          "mark": { "type": "text", "x": 30, "align": "left", "baseline": "middle", "fontSize": 13, "color": { "expr": "ink" }, "limit": { "expr": "labelWidth - 36" } },
          "encoding": {
            "y": { "field": "labY", "type": "quantitative", "scale": null },
            "text": { "field": "lab" },
            "opacity": null
          }
        }
      ]
    }
  ]
}
