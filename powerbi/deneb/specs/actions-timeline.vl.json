{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "When actions fall due: every open action on a date axis from the refresh date, Act above Watch, one line per action with its team and a short description, and the next 30 days shaded.",
  "data": { "name": "dataset" },
  "width": "container",
  "height": "container",
  "background": "transparent",
  "params": [
    { "name": "evergreen", "expr": "pbiColor(0)" },
    { "name": "emerald", "expr": "pbiColor(1)" },
    { "name": "sage", "value": "#DCE8E0" },
    { "name": "amber", "expr": "pbiColor(3)" },
    { "name": "red", "expr": "pbiColor(4)" },
    { "name": "ink", "expr": "pbiColor(0)" },
    { "name": "muted", "expr": "pbiColor(6)" },
    { "name": "line", "expr": "pbiColor(8)" },
    { "name": "surface", "value": "#FFFFFF" },
    { "name": "cream", "value": "#F7F6F2" },
    { "name": "goodFill", "value": "#DDF0E8" },
    { "name": "warnFill", "value": "#F5EAD6" },
    { "name": "badFill", "value": "#F3E0DA" },
    { "name": "title", "value": "WHEN ACTIONS FALL DUE" },
    { "name": "laneWidth", "value": 110 },
    { "name": "topSpace", "value": 30 },
    { "name": "laneGap", "value": 14 },
    { "name": "labelChars", "value": 42 },
    { "name": "dayMs", "value": 86400000 },
    {
      "name": "refreshTime",
      "expr": "length(data('dataset')) ? time(toDate(data('dataset')[0].due)) - toNumber(data('dataset')[0].daysFromRefresh) * dayMs : 0"
    },
    {
      "name": "endTime",
      "expr": "max(refreshTime + 30 * dayMs, length(data('dataset')) ? time(toDate(extent(pluck(data('dataset'), 'due'))[1])) : 0)"
    }
  ],
  "title": {
    "text": { "expr": "title" },
    "subtitle": { "expr": "length(data('dataset')) + ' open actions by due date · Act above, Watch below · data refreshed ' + timeFormat(refreshTime, '%-d %B %Y')" },
    "font": "JetBrains Mono, Consolas, monospace",
    "fontSize": 12.5,
    "fontWeight": 600,
    "color": { "expr": "muted" },
    "anchor": "start",
    "offset": 6,
    "subtitleFont": "Segoe UI, wf_segoe-ui_normal, Arial, sans-serif",
    "subtitleFontSize": 12,
    "subtitleColor": { "expr": "muted" },
    "subtitlePadding": 4
  },
  "transform": [
    { "calculate": "time(toDate(datum.due))", "as": "dueTime" },
    { "calculate": "toNumber(datum.daysFromRefresh)", "as": "days" },
    { "calculate": "datum.severity === 'act' ? 0 : 1", "as": "lane" },
    { "calculate": "datum.severity === 'act' ? 1 : 0", "as": "isAct" },
    {
      "window": [{ "op": "row_number", "as": "laneRow" }],
      "groupby": ["lane"],
      "sort": [{ "field": "days", "order": "ascending" }, { "field": "actionId", "order": "ascending" }]
    },
    {
      "joinaggregate": [
        { "op": "sum", "field": "isAct", "as": "actCount" },
        { "op": "count", "as": "total" },
        { "op": "max", "field": "days", "as": "maxDays" }
      ]
    },
    { "calculate": "max(1, (height - topSpace - laneGap) / max(1, datum.total))", "as": "rowH" },
    {
      "calculate": "topSpace + (datum.lane === 1 ? datum.actCount * datum.rowH + laneGap : 0) + (datum.laneRow - 0.5) * datum.rowH",
      "as": "rowY"
    },
    { "calculate": "datum.severity === 'act' ? red : amber", "as": "dotColour" },
    { "calculate": "datum.severity === 'act' ? 'Act' : 'Watch'", "as": "severityWord" },
    { "calculate": "datum.team + ' · ' + truncate(datum.description, labelChars)", "as": "shortLabel" },
    { "calculate": "timeFormat(datum.dueTime, '%-d %b %Y')", "as": "dueLabel" },
    { "calculate": "datum.days > max(30, datum.maxDays) * 0.6", "as": "labelLeft" },
    {
      "calculate": "isValid(datum.labCode) && datum.labCode !== '' ? datum.labCode + '' : upper(substring(datum.lab + '', 0, 2))",
      "as": "chipCode"
    },
    { "calculate": "isValid(datum.labColour) && datum.labColour !== '' ? datum.labColour + '' : muted", "as": "chipColour" },
    { "calculate": "datum.labelLeft ? -32 : 10", "as": "chipShift" }
  ],
  "encoding": {
    "x": {
      "field": "dueTime",
      "type": "temporal",
      "scale": {
        "type": "time",
        "domain": [{ "expr": "refreshTime - 2 * dayMs" }, { "expr": "endTime + 3 * dayMs" }],
        "range": [{ "expr": "laneWidth" }, { "expr": "max(laneWidth + 60, width)" }]
      },
      "axis": { "title": null, "format": "%-d %b", "tickCount": { "interval": "week", "step": 2 }, "labelFlush": true }
    },
    "y": { "field": "rowY", "type": "quantitative", "scale": null },
    "opacity": { "condition": { "test": "datum.__selected__ === 'off'", "value": 0.35 }, "value": 1 }
  },
  "layer": [
    {
      "transform": [
        { "aggregate": [{ "op": "min", "field": "actCount", "as": "actCount" }, { "op": "min", "field": "rowH", "as": "rowH" }] },
        { "calculate": "topSpace - 4", "as": "bandTop" },
        { "calculate": "topSpace + datum.actCount * datum.rowH + 4", "as": "bandBottom" }
      ],
      "mark": { "type": "rect", "x": 0, "x2": { "expr": "width" }, "color": { "expr": "cream" }, "cornerRadius": 6 },
      "encoding": {
        "x": null,
        "y": { "field": "bandTop", "type": "quantitative", "scale": null },
        "y2": { "field": "bandBottom" },
        "opacity": null
      }
    },
    {
      "data": { "values": [{ "label": "NEXT 30 DAYS" }] },
      "layer": [
        {
          "mark": {
            "type": "rect",
            "x": { "expr": "scale('x', refreshTime)" },
            "x2": { "expr": "scale('x', refreshTime + 30 * dayMs)" },
            "y": 0,
            "y2": { "expr": "height" },
            "color": { "expr": "sage" },
            "opacity": 0.45
          },
          "encoding": { "x": null, "y": null }
        },
        {
          "mark": {
            "type": "text",
            "x": { "expr": "scale('x', refreshTime + 30 * dayMs) - 6" },
            "y": 4,
            "align": "right",
            "baseline": "top",
            "font": "JetBrains Mono, Consolas, monospace",
            "fontSize": 11.5,
            "fontWeight": 600,
            "color": { "expr": "muted" }
          },
          "encoding": { "x": null, "y": null, "text": { "field": "label" } }
        }
      ]
    },
    {
      "data": { "values": [{ "word": "today" }] },
      "layer": [
        {
          "transform": [{ "calculate": "refreshTime", "as": "todayTime" }],
          "mark": {
            "type": "rule",
            "y": 0,
            "y2": { "expr": "height" },
            "color": { "expr": "ink" },
            "strokeWidth": 1.5
          },
          "encoding": { "x": { "field": "todayTime", "type": "temporal" }, "y": null }
        },
        {
          "mark": {
            "type": "text",
            "x": { "expr": "scale('x', refreshTime) + 6" },
            "y": 4,
            "align": "left",
            "baseline": "top",
            "font": "JetBrains Mono, Consolas, monospace",
            "fontSize": 11.5,
            "fontWeight": 600,
            "color": { "expr": "ink" }
          },
          "encoding": {
            "x": null,
            "y": null,
            "text": { "value": { "expr": "'TODAY · ' + upper(timeFormat(refreshTime, '%-d %b %Y'))" } }
          }
        }
      ]
    },
    {
      "transform": [
        { "aggregate": [{ "op": "min", "field": "actCount", "as": "actCount" }, { "op": "min", "field": "rowH", "as": "rowH" }, { "op": "min", "field": "total", "as": "total" }] },
        { "calculate": "[topSpace + datum.actCount * datum.rowH / 2, topSpace + datum.actCount * datum.rowH + laneGap + (datum.total - datum.actCount) * datum.rowH / 2]", "as": "laneMid" },
        { "calculate": "['ACT', 'WATCH']", "as": "laneWord" },
        { "calculate": "[datum.actCount + ' due', (datum.total - datum.actCount) + ' due']", "as": "laneCount" },
        { "flatten": ["laneMid", "laneWord", "laneCount"], "as": ["laneY", "laneName", "laneNote"] }
      ],
      "layer": [
        {
          "mark": {
            "type": "text",
            "x": 12,
            "align": "left",
            "baseline": "bottom",
            "font": "JetBrains Mono, Consolas, monospace",
            "fontSize": 12.5,
            "fontWeight": 600,
            "color": { "expr": "ink" }
          },
          "encoding": { "x": null, "y": { "field": "laneY", "type": "quantitative", "scale": null }, "text": { "field": "laneName" }, "opacity": null }
        },
        {
          "mark": { "type": "text", "x": 12, "align": "left", "baseline": "top", "dy": 3, "fontSize": 12, "color": { "expr": "muted" } },
          "encoding": { "x": null, "y": { "field": "laneY", "type": "quantitative", "scale": null }, "text": { "field": "laneNote" }, "opacity": null }
        }
      ]
    },
    {
      "params": [
        { "name": "__select__", "select": { "type": "point", "fields": ["actionId"], "on": "click", "clear": "dblclick" } }
      ],
      "mark": { "type": "circle", "size": 70, "stroke": { "expr": "surface" }, "strokeWidth": 1.5 },
      "encoding": {
        "color": { "field": "dotColour", "type": "nominal", "scale": null },
        "tooltip": [
          { "field": "actionId", "title": "Action" },
          { "field": "team", "title": "Team" },
          { "field": "lab", "title": "Lab" },
          { "field": "domain", "title": "Domain" },
          { "field": "description", "title": "Description" },
          { "field": "dueLabel", "title": "Due" },
          { "field": "daysFromRefresh", "title": "Days from refresh" },
          { "field": "severityWord", "title": "Severity" }
        ]
      }
    },
    {
      "layer": [
        {
          "mark": {
            "type": "rect",
            "cornerRadius": 4,
            "x": { "expr": "scale('x', datum.dueTime) + datum.chipShift" },
            "x2": { "expr": "scale('x', datum.dueTime) + datum.chipShift + 22" },
            "y": { "expr": "datum.rowY - 9" },
            "y2": { "expr": "datum.rowY + 9" }
          },
          "encoding": { "x": null, "y": null, "color": { "field": "chipColour", "type": "nominal", "scale": null } }
        },
        {
          "mark": {
            "type": "text",
            "x": { "expr": "scale('x', datum.dueTime) + datum.chipShift + 11" },
            "y": { "expr": "datum.rowY" },
            "align": "center",
            "baseline": "middle",
            "font": "JetBrains Mono, Consolas, monospace",
            "fontSize": 10,
            "fontWeight": 700,
            "color": { "expr": "surface" }
          },
          "encoding": { "x": null, "y": null, "text": { "field": "chipCode" } }
        }
      ]
    },
    {
      "transform": [{ "filter": "!datum.labelLeft" }],
      "mark": { "type": "text", "align": "left", "baseline": "middle", "dx": 38, "fontSize": 12, "color": { "expr": "ink" } },
      "encoding": { "text": { "field": "shortLabel" } }
    },
    {
      "transform": [{ "filter": "datum.labelLeft" }],
      "mark": { "type": "text", "align": "right", "baseline": "middle", "dx": -38, "fontSize": 12, "color": { "expr": "ink" } },
      "encoding": { "text": { "field": "shortLabel" } }
    }
  ]
}
